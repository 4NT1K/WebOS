# Arch Linux application repository.
#
# pacman is the package manager for applications on a SanusOS install; the
# base system itself stays Gentoo/Portage. Arch's packages are consumed as
# ebuilds through this overlay so that `emerge` can install them next to the
# Gentoo base (the Arch overlay exposes Arch packages, pacman included, as
# Gentoo ebuilds).
#
# Priority is deliberately lowest: the base system (gentoo, sanus) always wins
# over it, so Arch packages are only consulted for applications the base does
# not carry itself.
[arch]
location = /var/db/repos/arch
masters = gentoo
sync-type = git
sync-uri = https://github.com/sgallagher/archlinux-portage.git
auto-sync = yes
priority = -3000
