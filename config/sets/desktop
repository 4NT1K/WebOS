gui-libs/xdg-desktop-portal-hyprland
sys-apps/xdg-desktop-portal-gtk
gui-libs/xdg-desktop-portal-wlr
gui-libs/wlroots

# KDE Plasma is deliberately NOT here. It is in the separate @plasma set so a
# Full/Minimal image never inherits Plasma or its login session.

