# WebOS gaming per-package USE.

# Steam and friends need multilib and a lot of 32-bit libs.
games-util/steam-launcher steamruntime
app-emulation/wine-staging X alsa mono opencl vulkan pulseaudio
app-emulation/wine-vanilla X alsa mono opencl vulkan pulseaudio
games-emulation/dosbox-staging -debug
gui-wm/gamescope pipewire
games-util/gamemode -systemd elogind
games-util/mangohud X wayland
# sys-apps/lact gui

# 32-bit graphics stack (multilib) — required by Steam/Proton.
# Disabled for now to avoid multilib dependency complexity during initial build.
# Re-enable with ABI_X86="64 32" and appropriate deps for 32-bit Steam/Proton.
# media-libs/mesa abi_x86_32 vulkan wayland X vaapi
# media-libs/vulkan-loader abi_x86_32 wayland X
# media-libs/libglvnd abi_x86_32 X
# dev-libs/glib abi_x86_32 dbus
# app-arch/zstd abi_x86_32 -static-libs

# NVIDIA users: comment out VIDEO_CARDS="nvidia" in make.conf if not needed.
x11-drivers/nvidia-drivers tools

# Plasma 6.31+ needs these USE flags. Without them webos-update reports
# dependency conflicts on qtbase, qt5compat, kconfig and libdrm.
dev-qt/qtbase libproxy
dev-qt/qt5compat qml
kde-frameworks/kconfig qml
x11-libs/libdrm video_cards_radeon
