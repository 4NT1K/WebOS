# WebOS mono — mako, square, near-opaque, monochrome notifications.
# ~/.config/mako/config

font=JetBrainsMono Nerd Font 11
background-color=#000000eb
text-color=#D8D8D8
border-color=#e8e8e833
border-size=1
border-radius=0
progress-color=over #E8E8E8
padding=12
margin=10
width=340
height=120
max-visible=4
anchor=bottom-right
default-timeout=6000
group-by=app-name
icons=1
max-icon-size=40
icon-border-radius=0
layer=overlay
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss

[urgency=low]
border-color=#e8e8e81a
default-timeout=4000

[urgency=critical]
border-color=#f87171
default-timeout=0
background-color=#1a0b0bdd
