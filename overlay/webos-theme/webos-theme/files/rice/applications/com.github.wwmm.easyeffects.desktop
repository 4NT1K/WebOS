[Desktop Entry]
Name=Easy Effects
GenericName=Equalizer, Compressor and Other Audio Effects
Comment=Simple audio effects
Keywords=limiter;compressor;reverberation;equalizer;autovolume;
Categories=AudioVideo;Audio;
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=easyeffects com.github.wwmm.easyeffects
Icon=com.github.wwmm.easyeffects
StartupNotify=true
Terminal=false
Type=Application
X-Flatpak=com.github.wwmm.easyeffects
