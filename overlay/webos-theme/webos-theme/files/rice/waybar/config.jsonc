// ────────────────────────────────────────────────────────────────────────────
//  WebOS mono — a flat, near-opaque monochrome top bar.
//  Inspired by the MHD "Monochrome" rice: rounded, translucent capsules,
//  no colour, thin soft-white outline on the focused workspace, bold Mono text.
// ────────────────────────────────────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "height": 46,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 10,
    "fixed-center": true,
    "passthrough": false,
    "mode": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "ipc": false,
    "reload_style_on_change": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": ["mpris"],
    // No network module: the mono bar never displays the LAN IPv4 address.
    // No battery module either (desktop PC); the power menu stays available.
    "modules-right": ["custom/waypaper", "custom/update", "clock", "tray", "custom/perf", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true
    },

    "mpris": {
        // webos-mpris publishes Spotify first, then BetterSoundCloud's real
        // song/artist (never a playlist or the uploader name) as one player.
        "player": "webos",
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 42,
        "title-len": 30,
        "artist-len": 20,
        "album-len": 0,
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "▶",
            "spotify": "▶",
            "chromium": "▶",
            "bettersoundcloud": "▶",
            "firefox": "▶",
            "mpv": "▶"
        },
        "status-icons": { "paused": "❚❚" },
        "tooltip": "{player} — {title}\n{artist}",
        "on-click": "webos-music --toggle",
        "on-right-click": "webos-music --toggle"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#E8E8E8'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/waypaper": {
        "format": "▧",
        "tooltip": "Waypaper — choose wallpaper",
        "on-click": "waypaper"
    },

    "custom/update": {
        "format": "{}",
        "exec": "webos-update-indicator --check",
        "on-click": "webos-update-indicator --update",
        "interval": 60,
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": true,
        "return-type": "json"
    },

    "custom/perf": {
        "format": "▾",
        "tooltip": "Performance — CPU, GPU, VRAM, RAM, disk, temp",
        "on-click": "webos-stats --toggle"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": "Power — open session menu (reboot, shut down, suspend)",
        "on-click": "wlogout"
    }
}
