// ────────────────────────────────────────────────────────────────────────────
//  WebOS mono — a flat, transparent, monochrome top bar.
//  Inspired by the MHD "Monochrome" rice: no capsules, no colour, thin white
//  outline on the focused workspace, bold Meslo text.
// ────────────────────────────────────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "height": 46,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 10,
    "fixed-center": true,
    "passthrough": false,
    "mode": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "ipc": true,
    "reload_style_on_change": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    // No network module: the mono bar never displays the LAN IPv4 address.
    // No battery module either (desktop PC); the power menu stays available.
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "clock",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 30,
        "player-icons": {
            "default": ">",
            "spotify": ">",
            "firefox": ">",
            "mpv": ">"
        },
        "status-icons": { "paused": "||" },
        "tooltip-format": "{player} — {title}\n{artist}"
    },

    "cpu": {
        "interval": 3,
        "format": "cpu {usage}%",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "mem {percentage}%",
        "tooltip-format": "RAM {used:0.1f}/{total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/power": {
        "format": "power",
        "tooltip": "Power menu",
        "on-click": "wlogout"
    }
}
