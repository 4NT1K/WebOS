        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
        )
        card_provider[0] = provider
        set_text_colour(art_is_light(path))

    def load_art_async(url):
        """Prepare frosted art off the GTK thread so label updates never stall."""
        if url == art_loading[0]:
            return
        art_loading[0] = url
        if not url:
            set_art(None)
            art_loading[0] = None
            return

        def worker():
            path = prepare_art(url)

            def apply():
                if url != last_art[0]:
                    return False  # a newer track arrived while art was loading
                set_art(path)
                art_loading[0] = None
                return False

            GLib.idle_add(apply)

        threading.Thread(target=worker, daemon=True).start()

    def anchor_at(position, state):
        """Anchor the display to a seek without an extra playerctl call."""
        _position_anchor.update(
            identity=track_identity(state),
            position=max(0.0, to_float(position)),
            status=state.get("status", "playing"),
            at=time.monotonic(),
        )

    def on_seek(position):
        """Drop seeks straight to that point; playback continues from there."""
        if not seek_bar.enabled:
            return
        state = read_state()
        length = to_float(state.get("length"))
        if length <= 0:
            return
        target = max(0.0, min(float(position), length))
        spotifyctl("position", "%.2f" % target)
        anchor_at(target, state)
        seek_bar.set_value(target / length)
        elapsed_label.set_text(format_time(target))

    seek_bar.on_seek = on_seek

    def on_volume(value):
        """Apply the level as the bar is dragged; never touch the system sink."""
        set_volume(max(0.0, min(1.0, float(value))))

    volume_bar.on_change = on_volume

    def poll():
        state = read_state()
        status = state["status"]
        status_label.set_text(
            "PLAYING" if status == "playing" else "PAUSED" if status == "paused" else "STOPPED"
        )
        title_label.set_text(state["title"] or "No track")
        artist_label.set_text(state["artist"] or "")

        length = state["length"]
        position = synced_position(state)
        elapsed_label.set_text(format_time(position))
        total_label.set_text(format_time(length))

        volume, _muted = volume_state()
        if not volume_bar.dragging:
            volume_bar.set_value(volume)

        seek_bar.set_length(length)
        seek_bar.set_sensitive(length > 0)
        if length > 0 and not seek_bar.dragging:
            seek_bar.set_value(position / length)

        play_icon = "media-pause-symbolic" if status == "playing" else "media-playback-start-symbolic"
        if play_button.get_image():
            play_button.get_image().set_from_icon_name(play_icon, Gtk.IconSize.BUTTON)

        url = state["art_url"]
        if url != last_art[0]:
            last_art[0] = url
            load_art_async(url)

        visualizer.set_playing(status == "playing")
        return True

    def hide_dropdown():
        visualizer.stop()
        window.hide()
        catcher.hide()
        return False

    catcher_area.connect(
        "button-press-event", lambda *_: GLib.idle_add(hide_dropdown)
    )

    def toggle_visibility():
        if window.get_visible():
            hide_dropdown()
        else:
            catcher.show_all()
            if GtkLayerShell is None:
                catcher.fullscreen()
            window.show_all()
            window.present()
            visualizer.start()
            slide_down()
        return False

    def on_sigusr1(_signum, _frame):
        GLib.idle_add(toggle_visibility)

    def on_stop(_signum, _frame):
        GLib.idle_add(Gtk.main_quit)

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)

    poll()
    GLib.timeout_add(250, poll)

    if visible:
        catcher.show_all()
        if GtkLayerShell is None:
            catcher.fullscreen()
        window.show_all()
        window.present()
        visualizer.start()
        slide_down()
    window.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


def main(argv):
    options = set(arg for arg in argv if arg.startswith("--"))
    if len(options) != 1 or not options <= {"--start", "--toggle", "--run-hidden", "--run-visible"}:
        print("usage: webos-music {--start|--toggle|--run-hidden|--run-visible}", file=sys.stderr)
        return 2
    mode = next(iter(options))

    if mode == "--run-hidden":
        return run_app(False)
    if mode == "--run-visible":
        return run_app(True)

    pid = daemon_running()
    if mode == "--start":
        if pid is None:
            spawn(False)
        return 0

    # --toggle
    if pid is None:
        spawn(True)
    else:
        try:
            os.kill(pid, signal.SIGUSR1)
        except OSError:
            spawn(False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
