#!/usr/bin/env python3
"""WebOS now-playing overlay (GTK3 + gtk-layer-shell, no eww/ags/hyprwave).

Modes:
  --start          launch the hidden daemon if it is not already running
  --toggle         toggle the overlay via SIGUSR1 (start it if necessary)
  --run-hidden     internal: run the daemon with the window hidden
  --run-visible    internal: run the daemon with the window visible
"""

import atexit
import hashlib
import io
import json
import math
import os
import signal
import subprocess
import sys
import tempfile
import threading
import urllib.parse
import urllib.request


def runtime_dir():
    path = os.environ.get("XDG_RUNTIME_DIR")
    if not path:
        path = os.path.join(tempfile.gettempdir(), "webos-" + str(os.getuid()))
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except OSError:
        pass
    return path


RUNTIME = runtime_dir()
PIDFILE = os.path.join(RUNTIME, "webos-music.pid")
ART_DIR = os.path.join(RUNTIME, "webos-music-art")

# Fallback geometry when gtk-layer-shell's introspection typelib is missing.
PANEL_SIZE = 340
TOP_GAP = 100  # below the 46 px waybar plus margins

META_FORMAT = "{{title}}\t{{artist}}\t{{mpris:length}}\t{{mpris:artUrl}}"


# ---------------------------------------------------------------------------
# process management (uses only the standard library)
# ---------------------------------------------------------------------------

def read_pid():
    try:
        with open(PIDFILE, "r", encoding="utf-8") as handle:
            pid = int(handle.read().strip())
        return pid if pid > 0 else None
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def daemon_running():
    pid = read_pid()
    if pid_alive(pid):
        return pid
    if pid:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
    return None


def write_pidfile():
    with open(PIDFILE, "w", encoding="utf-8") as handle:
        handle.write(str(os.getpid()) + "\n")


def remove_pidfile():
    if read_pid() == os.getpid():
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def spawn(visible):
    flag = "--run-visible" if visible else "--run-hidden"
    devnull = open(os.devnull, "rb")
    try:
        subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), flag],
            stdin=devnull,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    finally:
        devnull.close()


# ---------------------------------------------------------------------------
# playerctl / artwork (standard library + Pillow)
# ---------------------------------------------------------------------------

def playerctl(*args):
    try:
        proc = subprocess.run(
            ["playerctl", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def hyprctl(*args):
    try:
        proc = subprocess.run(
            ["hyprctl", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def to_float(value, default=0.0):
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def read_state():
    status = playerctl("status").lower()
    fields = playerctl("metadata", "--format", META_FORMAT).split("\t")
    fields += [""] * (4 - len(fields))
    title, artist, length_raw, art_url = fields[:4]
    length = to_float(length_raw) / 1000000.0 if length_raw else 0.0
    position = to_float(playerctl("position"))
    return {
        "status": status if status in ("playing", "paused") else "stopped",
        "title": title,
        "artist": artist,
        "length": length,
        "position": position,
        "art_url": art_url,
    }


def prepare_art(url):
    """Fetch/cache a square, lightly frosted copy of the cover art."""
    if not url or not url.startswith(("file://", "http://", "https://")):
        return None
    try:
        os.makedirs(ART_DIR, mode=0o700, exist_ok=True)
        key = hashlib.sha256(url.encode("utf-8")).hexdigest()[:12]
        cached = os.path.join(ART_DIR, key + "-bg.png")
        if os.path.isfile(cached):
            return cached

        from PIL import Image, ImageEnhance, ImageFilter, ImageOps

        if url.startswith("file://"):
            parsed = urllib.parse.urlparse(url)
            source = urllib.parse.unquote(parsed.path)
            with open(source, "rb") as handle:
                raw = handle.read()
        else:
            with urllib.request.urlopen(url, timeout=2) as response:
                raw = response.read()

        image = Image.open(io.BytesIO(raw)).convert("RGB")
        resample = getattr(getattr(Image, "Resampling", Image), "LANCZOS")

        # Cover-crop to the square panel, blur just enough to frost it, then
        # crop the soft edge away. Keep it bright enough to recognise the art.
        overscan = PANEL_SIZE + 48
        frost = ImageOps.fit(image, (overscan, overscan), resample)
        frost = frost.filter(ImageFilter.GaussianBlur(radius=9))
        frost = frost.crop((24, 24, 24 + PANEL_SIZE, 24 + PANEL_SIZE))
        frost = ImageEnhance.Brightness(frost).enhance(0.72)
        frost.save(cached, format="PNG")

        # Drop the older greyscale/dual-image caches for this track.
        for suffix in (".png", "-color.png", "-frost.png"):
            old = os.path.join(ART_DIR, key + suffix)
            if old != cached:
                try:
                    os.unlink(old)
                except OSError:
                    pass
        return cached
    except Exception:
        return None


def art_palette(path, count=20):
    """Pull a handful of recognisable colours out of the cached cover art."""
    fallback = [(232, 232, 232)] * count
    if not path:
        return fallback
    try:
        from PIL import Image
        image = Image.open(path).convert("RGB").resize((48, 48))
        quantized = image.quantize(colors=6)
        palette = quantized.getpalette() or []
        ranked = sorted(quantized.getcolors() or [], reverse=True)
        colours = []
        for _used, index in ranked:
            rgb = tuple(palette[index * 3:index * 3 + 3])
            if len(rgb) == 3 and max(rgb) - min(rgb) >= 18 and max(rgb) >= 50:
                colours.append(rgb)
        if not colours:
            return fallback
        return [colours[i % len(colours)] for i in range(count)]
    except Exception:
        return fallback


def active_mpris_player():
    """Return the playing MPRIS player, or the first listed one when paused."""
    players = [line.strip() for line in playerctl("-l").splitlines() if line.strip()]
    if not players:
        return None
    for player in players:
        if playerctl("--player=" + player, "status").lower() == "playing":
            return player
    return players[0]


def music_node_target(player):
    """Resolve an MPRIS player to its own PipeWire output node name."""
    if not player:
        return None
    try:
        proc = subprocess.run(
            ["pw-dump"], stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=3, check=False,
        )
        objects = json.loads(proc.stdout.decode("utf-8", "replace")) if proc.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        objects = []

    def normal(value):
        return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

    wanted = normal(player)
    for obj in objects:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("media.class") != "Stream/Output/Audio":
            continue
        name = str(props.get("node.name") or "")
        for candidate in (name, props.get("application.name"),
                          props.get("media.name")):
            found = normal(candidate)
            if found and (found == wanted or found in wanted or wanted in found):
                return name
    # No discoverable node name: let pw-record try the MPRIS name directly.
    return player


class AudioVisualizer:
    """cava-driven bars from the active MPRIS player's PipeWire node."""

    BANDS = 20

    def __init__(self, area):
        self.area = area
        self.bars = [0.0] * self.BANDS
        self.levels = [0.0] * self.BANDS
        self.colours = [(232, 232, 232)] * self.BANDS
        self.proc = None
        self.thread = None
        self.running = False
        self.target = None
        self.config = None

    def set_colours(self, colours):
        if colours and len(colours) >= self.BANDS:
            self.colours = list(colours[:self.BANDS])

    def set_target(self, target):
        """Switch the capture to a different player, if it changed."""
        if target == self.target:
            return False
        was_running = self.running
        if was_running:
            self.stop()
        self.target = target
        if was_running:
            self.start()
        return True

    def start(self):
        if self.running or not self.target:
            return
        self.config = os.path.join(runtime_dir(), "webos-music-cava.conf")
        try:
            with open(self.config, "w", encoding="utf-8") as handle:
                handle.write(
                    "[general]\nbars = %d\n\n"
                    "[input]\nmethod = pipewire\nsource = %s\n\n"
                    "[output]\nmethod = raw\nraw_target = /dev/stdout\n"
                    "data_format = ascii\nascii_max_range = 100\n"
                    % (self.BANDS, self.target)
                )
            self.proc = subprocess.Popen(
                ["cava", "-p", self.config],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
        except (OSError, ValueError):
            self.proc = None
            return
        self.running = True
        self.thread = threading.Thread(target=self._reader, daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False
        if self.proc is not None:
            for action in ("terminate", "kill"):
                try:
                    getattr(self.proc, action)()
                    self.proc.wait(timeout=1)
                    break
                except (OSError, subprocess.SubprocessError):
                    continue
            self.proc = None
        if self.config:
            try:
                os.unlink(self.config)
            except OSError:
                pass
            self.config = None
        self.bars = [0.0] * self.BANDS
        self.levels = [0.0] * self.BANDS
        self.area.queue_draw()

    def _reader(self):
        while self.running and self.proc is not None:
            try:
                line = self.proc.stdout.readline()
            except (OSError, ValueError):
                break
            if not line:
                break
            try:
                values = [int(part) for part in
                          line.decode("utf-8", "replace").strip().split(";")
                          if part.strip()]
            except ValueError:
                continue
            values = (values + [0] * self.BANDS)[:self.BANDS]
            raw = [min(1.0, max(0.0, value / 100.0)) ** 0.85 for value in values]
            # cava already smooths; this only takes the edge off stray frames.
            for index, value in enumerate(raw):
                level = self.levels[index]
                weight = 0.35 if value > level else 0.12
                self.levels[index] = level + (value - level) * weight
                self.bars[index] = self.levels[index]
            try:
                from gi.repository import GLib
                GLib.idle_add(self.area.queue_draw)
            except Exception:
                pass

    def draw(self, area, cr):
        width = area.get_allocated_width()
        height = area.get_allocated_height()
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.0)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        gap = 3.0
        bar_width = (width - gap * (self.BANDS - 1)) / self.BANDS
        for index, level in enumerate(self.bars):
            bar_height = max(2.0, level * height)
            x = index * (bar_width + gap)
            y = height - bar_height
            radius = min(bar_width / 2.0, 5.0, bar_height / 2.0)

            # Rounded-top bar, clipped while the vertical gradient is painted.
            cr.new_path()
            cr.move_to(x, y + bar_height)
            cr.line_to(x, y + radius)
            cr.arc(x + radius, y + radius, radius, math.pi, 1.5 * math.pi)
            cr.line_to(x + bar_width - radius, y)
            cr.arc(x + bar_width - radius, y + radius, radius,
                   1.5 * math.pi, 2.0 * math.pi)
            cr.line_to(x + bar_width, y + bar_height)
            cr.close_path()
            cr.save()
            cr.clip()

            red, green, blue = self.colours[index]
            stripes = 10
            for stripe in range(stripes):
                stripe_y = y + bar_height * stripe / stripes
                stripe_h = bar_height / stripes + 1.0
                brightness = 0.42 + 0.58 * (1.0 - stripe / float(stripes))
                cr.set_source_rgba(red * brightness / 255.0,
                                   green * brightness / 255.0,
                                   blue * brightness / 255.0, 0.92)
                cr.rectangle(x, stripe_y, bar_width, stripe_h)
                cr.fill()
            cr.restore()


def format_time(seconds):
    seconds = max(0, int(to_float(seconds)))
    hours, remainder = divmod(seconds, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return "%d:%02d:%02d" % (hours, minutes, secs)
    return "%d:%02d" % (minutes, secs)


# ---------------------------------------------------------------------------
# GTK overlay
# ---------------------------------------------------------------------------

def run_app(visible):
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    # WebOS ships GtkLayerShell-0.1.typelib; some newer systems expose 1.0.
    # Requesting the wrong version silently falls back to normal toplevel
    # windows, which made the click-catcher appear as an empty box.
    GtkLayerShell = None
    for version in ("0.1", "1.0"):
        try:
            gi.require_version("GtkLayerShell", version)
            from gi.repository import GtkLayerShell
            break
        except (ImportError, ValueError):
            continue

    write_pidfile()
    atexit.register(remove_pidfile)

    CSS = b"""
    #music-card {
        background-color: #000000;
        border: 1px solid rgba(232, 232, 232, 0.20);
        border-radius: 18px;
        color: #D8D8D8;
        padding: 14px;
        box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.28);
    }
    .webos-status {
        color: #D8D8D8;
        font: bold 12px "JetBrains Mono", "DejaVu Sans Mono", monospace;
        letter-spacing: 2px;
    }
    #webos-music-catcher, #webos-music-catcher-area {
        background-color: transparent;
    }
    .webos-title {
        color: #D8D8D8;
        font: bold 14px "JetBrains Mono", "DejaVu Sans Mono", monospace;
    }
    .webos-dim {
        color: #7A7A7A;
        font: 11px "JetBrains Mono", "DejaVu Sans Mono", monospace;
    }
    button {
        color: #D8D8D8;
        background-color: rgba(232, 232, 232, 0.04);
        border: 1px solid rgba(232, 232, 232, 0.20);
        border-radius: 9px;
        padding: 4px 10px;
    }
    scale, scale trough, scale progress {
        background-color: rgba(232, 232, 232, 0.08);
        border-radius: 4px;
    }
    scale progress {
        background-color: #E8E8E8;
    }
    """

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    screen = Gdk.Screen.get_default()
    Gtk.StyleContext.add_provider_for_screen(
        screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    # Transparent fullscreen surface behind the card. A click anywhere that is
    # not the card dismisses the dropdown (Wayland has no global click grab).
    catcher = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    catcher.set_title("webos-music-outside")
    catcher.set_decorated(False)
    catcher.set_skip_taskbar_hint(True)
    catcher.set_skip_pager_hint(True)
    catcher.set_app_paintable(True)
    # Keep the surface hit-testable but completely invisible. On Wayland a
    # transparent GTK background alone can still arrive as an opaque dark
    # buffer, which used to dim the whole desktop behind the dropdown.
    catcher.set_opacity(0.0)
    catcher.set_name("webos-music-catcher")
    rgba_screen = Gdk.Screen.get_default()
    rgba_visual = rgba_screen.get_rgba_visual() if rgba_screen else None
    if rgba_visual is not None:
        catcher.set_visual(rgba_visual)
    if GtkLayerShell is not None:
        GtkLayerShell.init_for_window(catcher)
        GtkLayerShell.set_layer(catcher, GtkLayerShell.Layer.TOP)
        for edge in ("LEFT", "RIGHT", "TOP", "BOTTOM"):
            GtkLayerShell.set_anchor(catcher, getattr(GtkLayerShell.Edge, edge), True)
            GtkLayerShell.set_margin(catcher, getattr(GtkLayerShell.Edge, edge), 0)
        GtkLayerShell.set_exclusive_zone(catcher, -1)
        try:
            GtkLayerShell.set_namespace(catcher, "webos-music-outside")
        except AttributeError:
            pass
    else:
        # gtk-layer-shell is not installed on every live system. On Wayland
        # GDK often has no "primary" monitor, so use monitor 0 explicitly;
        # otherwise the catcher stays at GTK's default 200x200 and shows up as
        # an empty box underneath the card.
        display = Gdk.Display.get_default()
        monitor = None
        if display is not None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor is not None:
            geometry = monitor.get_geometry()
            catcher.set_default_size(geometry.width, geometry.height)
            catcher.move(geometry.x, geometry.y)
        catcher.set_keep_below(True)
    catcher_area = Gtk.EventBox()
    catcher_area.set_name("webos-music-catcher-area")
    catcher.add(catcher_area)

    window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    window.set_title("webos-music")
    window.set_decorated(False)
    window.set_resizable(False)
    window.set_skip_taskbar_hint(True)
    window.set_skip_pager_hint(True)
    window.set_default_size(PANEL_SIZE, PANEL_SIZE)
    window.set_app_paintable(True)
    if rgba_visual is not None:
        window.set_visual(rgba_visual)
    if GtkLayerShell is None:
        # Keep the card above the fullscreen click-catcher without layer-shell.
        window.set_transient_for(catcher)
        window.set_keep_above(True)

    if GtkLayerShell is not None:
        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
        for edge in ("LEFT", "RIGHT", "BOTTOM"):
            GtkLayerShell.set_anchor(window, getattr(GtkLayerShell.Edge, edge), False)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(window, GtkLayerShell.Edge.TOP, 100)
        GtkLayerShell.set_exclusive_zone(window, -1)
        try:
            GtkLayerShell.set_namespace(window, "webos-music")
        except AttributeError:
            pass  # older bindings still anchor correctly, just without a namespace

    def fallback_position(y):
        """Hyprland fallback when gtk-layer-shell introspection is unavailable."""
        if GtkLayerShell is not None:
            return None
        display = Gdk.Display.get_default()
        if display is None:
            return None
        try:
            gdk_window = window.get_window()
            monitor = (display.get_monitor_at_window(gdk_window) if gdk_window
                       else display.get_primary_monitor())
        except Exception:
            monitor = None
        if monitor is None:
            return None
        geometry = monitor.get_geometry()
        x = geometry.x + max(0, (geometry.width - PANEL_SIZE) // 2)
        return x, geometry.y + y

    def slide_down():
        """Animate the panel downward from above the bar into place."""
        frames = 12
        tick = [0]

        def step():
            progress = min(1.0, tick[0] / float(frames))
            eased = 1.0 - (1.0 - progress) ** 3
            if GtkLayerShell is not None:
                margin = int(round(100 - PANEL_SIZE + PANEL_SIZE * eased))
                GtkLayerShell.set_margin(window, GtkLayerShell.Edge.TOP, margin)
            else:
                # Do not wait for focus: the transparent catcher can become
                # the active window instead, which used to stall the animation.
                position = fallback_position(
                    int(round(TOP_GAP - PANEL_SIZE + PANEL_SIZE * eased))
                )
                if position is None:
                    return False
                hyprctl("dispatch", "hl.dsp.window.move({ x = %d, y = %d })" % position)
            tick[0] += 1
            return tick[0] <= frames

        GLib.timeout_add(24, step)
        return False

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    card.set_name("music-card")
    card.set_size_request(PANEL_SIZE, PANEL_SIZE)
    window.add(card)

    status_label = Gtk.Label(label="STOPPED")
    status_label.set_name("music-status")
    status_label.set_halign(Gtk.Align.START)
    status_label.get_style_context().add_class("webos-status")
    card.pack_start(status_label, False, False, 0)

    title_label = Gtk.Label(label="No track")
    title_label.set_halign(Gtk.Align.START)
    title_label.set_ellipsize(3)  # Pango.EllipsizeMode.END
    title_label.set_max_width_chars(32)
    title_label.get_style_context().add_class("webos-title")
    card.pack_start(title_label, False, False, 0)

    artist_label = Gtk.Label(label="")
    artist_label.set_halign(Gtk.Align.START)
    artist_label.set_ellipsize(3)
    artist_label.set_max_width_chars(32)
    artist_label.get_style_context().add_class("webos-dim")
    card.pack_start(artist_label, False, False, 0)

    # Audio visualizer fills the middle of the square. Its bars take their
    # colours from the current cover art (set_art below).
    visual = Gtk.DrawingArea()
    visual.set_name("music-viz")
    visual.set_hexpand(True)
    visual.set_vexpand(True)
    card.pack_start(visual, True, True, 0)
    visualizer = AudioVisualizer(visual)
    visual.connect("draw", visualizer.draw)

    controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    controls.set_halign(Gtk.Align.CENTER)
    card.pack_start(controls, False, False, 0)

    def control(icon, command):
        button = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
        button.connect("clicked", lambda *_: playerctl(command))
        controls.pack_start(button, False, False, 0)
        return button

    control("media-skip-backward-symbolic", "previous")
    play_button = control("media-playback-start-symbolic", "play-pause")
    control("media-skip-forward-symbolic", "next")

    timeline = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    card.pack_start(timeline, False, False, 0)

    elapsed_label = Gtk.Label(label="0:00")
    elapsed_label.get_style_context().add_class("webos-dim")
    timeline.pack_start(elapsed_label, False, False, 0)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 1.0, 0.01)
    scale.set_draw_value(False)
    scale.set_sensitive(False)
    timeline.pack_start(scale, True, True, 0)

    total_label = Gtk.Label(label="0:00")
    total_label.get_style_context().add_class("webos-dim")
    timeline.pack_start(total_label, False, False, 0)

    last_art = [None]
    last_player = [None]
    updating = [False]
    card_provider = [None]

    def set_art(path):
        # The song image fills the whole square card, frosted but recognisable.
        if card_provider[0] is not None:
            Gtk.StyleContext.remove_provider_for_screen(screen, card_provider[0])
            card_provider[0] = None
        if not path:
            visualizer.set_colours([(232, 232, 232)] * visualizer.BANDS)
            return
        css = ("#music-card { background-image: url(%s); background-size: cover; }"
               % json.dumps(path)).encode("utf-8")
        visualizer.set_colours(art_palette(path, visualizer.BANDS))
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
        )
        card_provider[0] = provider

    def on_seek(_widget):
        if updating[0]:
            return
        playerctl("position", "%.2f" % scale.get_value())

    scale.connect("value-changed", on_seek)

    def poll():
        state = read_state()
        status = state["status"]
        status_label.set_text(
            "PLAYING" if status == "playing" else "PAUSED" if status == "paused" else "STOPPED"
        )
        title_label.set_text(state["title"] or "No track")
        artist_label.set_text(state["artist"] or "")
        elapsed_label.set_text(format_time(state["position"]))
        total_label.set_text(format_time(state["length"]))

        length = state["length"]
        scale.set_sensitive(length > 0)
        if length > 0:
            updating[0] = True
            scale.set_range(0.0, length)
            scale.set_value(min(max(state["position"], 0.0), length))
            updating[0] = False

        play_icon = "media-pause-symbolic" if status == "playing" else "media-playback-start-symbolic"
        if play_button.get_image():
            play_button.get_image().set_from_icon_name(play_icon, Gtk.IconSize.BUTTON)

        url = state["art_url"]
        if url != last_art[0]:
            last_art[0] = url
            set_art(prepare_art(url) if url else None)

        player = active_mpris_player()
        if player != last_player[0]:
            last_player[0] = player
            visualizer.set_target(music_node_target(player))
        return True

    def hide_dropdown():
        visualizer.stop()
        window.hide()
        catcher.hide()
        return False

    catcher_area.connect(
        "button-press-event", lambda *_: GLib.idle_add(hide_dropdown)
    )

    def toggle_visibility():
        if window.get_visible():
            hide_dropdown()
        else:
            catcher.show_all()
            if GtkLayerShell is None:
                catcher.fullscreen()
            window.show_all()
            window.present()
            visualizer.start()
            slide_down()
        return False

    def on_sigusr1(_signum, _frame):
        GLib.idle_add(toggle_visibility)

    def on_stop(_signum, _frame):
        GLib.idle_add(Gtk.main_quit)

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)

    poll()
    GLib.timeout_add(1000, poll)

    if visible:
        catcher.show_all()
        if GtkLayerShell is None:
            catcher.fullscreen()
        window.show_all()
        window.present()
        visualizer.start()
        slide_down()
    window.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


def main(argv):
    options = set(arg for arg in argv if arg.startswith("--"))
    if len(options) != 1 or not options <= {"--start", "--toggle", "--run-hidden", "--run-visible"}:
        print("usage: webos-music {--start|--toggle|--run-hidden|--run-visible}", file=sys.stderr)
        return 2
    mode = next(iter(options))

    if mode == "--run-hidden":
        return run_app(False)
    if mode == "--run-visible":
        return run_app(True)

    pid = daemon_running()
    if mode == "--start":
        if pid is None:
            spawn(False)
        return 0

    # --toggle
    if pid is None:
        spawn(True)
    else:
        try:
            os.kill(pid, signal.SIGUSR1)
        except OSError:
            spawn(False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
