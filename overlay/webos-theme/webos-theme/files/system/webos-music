#!/usr/bin/env python3
"""WebOS now-playing overlay (GTK3 + gtk-layer-shell, no eww/ags/hyprwave).

Modes:
  --start          launch the hidden daemon if it is not already running
  --toggle         toggle the overlay via SIGUSR1 (start it if necessary)
  --run-hidden     internal: run the daemon with the window hidden
  --run-visible    internal: run the daemon with the window visible
"""

import atexit
import cairo
import hashlib
import io
import json
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request


def runtime_dir():
    path = os.environ.get("XDG_RUNTIME_DIR")
    if not path:
        path = os.path.join(tempfile.gettempdir(), "webos-" + str(os.getuid()))
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except OSError:
        pass
    return path


RUNTIME = runtime_dir()
PIDFILE = os.path.join(RUNTIME, "webos-music.pid")
ART_DIR = os.path.join(RUNTIME, "webos-music-art")

# BetterSoundCloud publishes its current track here through the bundled
# "webos-now-playing" plugin. It is a plain JSON file so the card can show
# SoundCloud songs without turning BSC into an MPRIS player.
BSC_DATA = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"),
    "BetterSoundCloud", "plugin-data", "webos-now-playing.json",
)

# Fallback geometry when gtk-layer-shell's introspection typelib is missing.
PANEL_SIZE = 340
TOP_GAP = 100  # below the 46 px waybar plus margins

META_FORMAT = ("{{status}}\t{{title}}\t{{artist}}\t{{mpris:length}}\t"
               "{{mpris:artUrl}}\t{{position}}\t{{mpris:trackid}}")
META_FIELDS = 7


def run_quiet(args):
    """Best-effort helper for host commands that may not be installed."""
    try:
        subprocess.run(args, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# process management (uses only the standard library)
# ---------------------------------------------------------------------------

def read_pid():
    try:
        with open(PIDFILE, "r", encoding="utf-8") as handle:
            pid = int(handle.read().strip())
        return pid if pid > 0 else None
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def daemon_running():
    pid = read_pid()
    if pid_alive(pid):
        return pid
    if pid:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
    return None


def write_pidfile():
    with open(PIDFILE, "w", encoding="utf-8") as handle:
        handle.write(str(os.getpid()) + "\n")


def remove_pidfile():
    if read_pid() == os.getpid():
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def spawn(visible):
    flag = "--run-visible" if visible else "--run-hidden"
    devnull = open(os.devnull, "rb")
    try:
        subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), flag],
            stdin=devnull,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    finally:
        devnull.close()


# ---------------------------------------------------------------------------
# playerctl / artwork (standard library + Pillow)
# ---------------------------------------------------------------------------

def playerctl(*args):
    try:
        proc = subprocess.run(
            ["playerctl", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def spotify_active():
    """True only when Spotify is exposed as an MPRIS player."""
    return any(
        line.strip().lower().startswith("spotify")
        for line in playerctl("-l").splitlines()
        if line.strip()
    )


def spotifyctl(*args):
    """Run playerctl against Spotify only; never control osu!/Firefox/etc."""
    # An explicit --player=spotify is enough to keep other players untouched;
    # skipping a separate `playerctl -l` here avoids an extra subprocess on
    # every poll (and therefore a visible delay in the card update).
    return playerctl("--player=spotify", *args)


def bsc_state():
    """Read the track published by BetterSoundCloud's now-playing plugin.

    Returns the same shape as read_state() so the rest of the card does not
    care which app is playing. Sampled time is stored so synced_position()
    advances the elapsed label between plugin updates.
    """
    sampled_at = time.monotonic()
    empty = {
        "player": "bsc", "status": "stopped", "title": "", "artist": "",
        "length": 0.0, "position": 0.0, "art_url": "", "track_id": "",
        "sampled_at": sampled_at,
    }
    try:
        with open(BSC_DATA, "r", encoding="utf-8") as handle:
            stored = json.load(handle)
    except (OSError, ValueError):
        return empty
    track = stored.get("track") if isinstance(stored, dict) else None
    if not isinstance(track, dict) or not (track.get("title") or track.get("artist")):
        return empty
    length = to_float(track.get("duration"))
    position = to_float(track.get("elapsed"))
    if length > 0:
        position = min(position, length)
    status = "playing" if track.get("playing") is True else "paused"
    return {
        "player": "bsc",
        "status": status,
        "title": str(track.get("title") or ""),
        "artist": str(track.get("artist") or ""),
        "length": length,
        "position": position,
        "art_url": str(track.get("artwork") or ""),
        "track_id": str(track.get("url") or track.get("title") or ""),
        "sampled_at": sampled_at,
    }


def bsc_active():
    """True when BetterSoundCloud has published a track we can display."""
    state = bsc_state()
    return bool(state["title"] or state["artist"])


def hyprctl(*args):
    try:
        proc = subprocess.run(
            ["hyprctl", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def to_float(value, default=0.0):
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


# Remembered Spotify-only volume, used for the slider while Spotify is closed.
_spotify_volume = [1.0]


def pactl_sink_inputs():
    """Return pactl's sink-input listing, or '' when unavailable."""
    try:
        proc = subprocess.run(
            ["pactl", "list", "sink-inputs"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace")


def spotify_streams():
    """Return Spotify's streams as [(id, volume 0.0-1.0, muted), ...].

    Matching is done on the stream's application/media name only, so no
    other application's audio is ever read or changed.
    """
    text = pactl_sink_inputs()
    streams = []
    for block in re.split(r"(?m)^Sink Input #", text)[1:]:
        lines = block.splitlines()
        if not lines:
            continue
        sid = re.match(r"(\d+)", lines[0].strip())
        if not sid:
            continue
        names = re.findall(
            r'^\s*(?:application\.name|media\.name)\s*=\s*"([^"]+)"',
            block, re.MULTILINE,
        )
        if not any(name.strip().lower() == "spotify" for name in names):
            continue
        vol_match = re.search(r"^\s*Volume:.*?(\d+)\s*%", block, re.MULTILINE)
        volume = to_float(vol_match.group(1) if vol_match else 100, 100) / 100.0
        mute_match = re.search(r"^\s*Mute:\s*(yes|no)", block, re.MULTILINE)
        muted = bool(mute_match and mute_match.group(1) == "yes")
        streams.append((sid.group(1), min(max(volume, 0.0), 1.0), muted))
    return streams


def volume_state():
    """Read Spotify's own stream volume/mute as (0.0-1.0, muted)."""
    streams = spotify_streams()
    if not streams:
        return _spotify_volume[0], False
    _spotify_volume[0] = streams[0][1]
    return streams[0][1], all(stream[2] for stream in streams)


def set_volume(value):
    """Set Spotify's stream volume only - never the system default sink."""
    value = min(max(value, 0.0), 1.0)
    _spotify_volume[0] = value
    streams = spotify_streams()
    if not streams:
        return
    percent = "%d%%" % int(round(value * 100))
    for sid, _volume, _muted in streams:
        run_quiet(["pactl", "set-sink-input-volume", sid, percent])


def _read_spotify_state():
    """Read Spotify's whole card state in one playerctl call."""
    fields = spotifyctl("metadata", "--format", META_FORMAT).split("\t")
    sampled_at = time.monotonic()
    fields += [""] * (META_FIELDS - len(fields))
    (status, title, artist, length_raw, art_url, position_raw,
     track_id) = fields[:META_FIELDS]
    length = to_float(length_raw) / 1000000.0 if length_raw else 0.0
    # {{position}} is reported in microseconds, unlike `playerctl position`.
    position = to_float(position_raw) / 1000000.0 if position_raw else 0.0
    status = status.strip().lower()
    return {
        "player": "spotify",
        "status": status if status in ("playing", "paused") else "stopped",
        "title": title,
        "artist": artist,
        "length": length,
        "position": position,
        "art_url": art_url,
        "track_id": track_id,
        "sampled_at": sampled_at,
    }


def read_state():
    """Spotify first, then BetterSoundCloud when Spotify has no track.

    Both return the same fields, so the card, vinyl and progress bar need no
    per-app branches. Volume control stays Spotify-only by design.
    """
    spotify = _read_spotify_state()
    if spotify["status"] != "stopped" or spotify["title"]:
        return spotify
    return bsc_state()


def prepare_art(url):
    """Fetch/cache a square, lightly frosted copy of the cover art."""
    if not url or not url.startswith(("file://", "http://", "https://")):
        return None
    try:
        os.makedirs(ART_DIR, mode=0o700, exist_ok=True)
        key = hashlib.sha256(url.encode("utf-8")).hexdigest()[:12]
        cached = os.path.join(ART_DIR, key + "-bg.png")
        if os.path.isfile(cached):
            return cached

        from PIL import Image, ImageEnhance, ImageFilter, ImageOps

        if url.startswith("file://"):
            parsed = urllib.parse.urlparse(url)
            source = urllib.parse.unquote(parsed.path)
            with open(source, "rb") as handle:
                raw = handle.read()
        else:
            with urllib.request.urlopen(url, timeout=2) as response:
                raw = response.read()

        image = Image.open(io.BytesIO(raw)).convert("RGB")
        resample = getattr(getattr(Image, "Resampling", Image), "LANCZOS")

        # Cover-crop to the square panel, blur just enough to frost it, then
        # crop the soft edge away. Keep it bright enough to recognise the art.
        overscan = PANEL_SIZE + 48
        frost = ImageOps.fit(image, (overscan, overscan), resample)
        frost = frost.filter(ImageFilter.GaussianBlur(radius=2.5))
        frost = frost.crop((24, 24, 24 + PANEL_SIZE, 24 + PANEL_SIZE))
        frost = ImageEnhance.Brightness(frost).enhance(1.0)
        frost.save(cached, format="PNG")

        # Drop the older greyscale/dual-image caches for this track.
        for suffix in (".png", "-color.png", "-frost.png"):
            old = os.path.join(ART_DIR, key + suffix)
            if old != cached:
                try:
                    os.unlink(old)
                except OSError:
                    pass
        return cached
    except Exception:
        return None


def art_is_light(path):
    """True when the frosted cover is bright enough to need dark lettering."""
    if not path:
        return False
    try:
        from PIL import Image, ImageStat
        image = Image.open(path).convert("L").resize((64, 64))
        mean = ImageStat.Stat(image).mean[0]
        data = getattr(image, "get_flattened_data", image.getdata)()
        light_fraction = sum(1 for value in data if value >= 170) / 4096.0
        return mean >= 160 or light_fraction >= 0.55
    except Exception:
        return False


def active_mpris_player(state=None):
    """Spotify, or BetterSoundCloud when Spotify has no track.

    Firefox/osu!/other MPRIS players are still ignored; only the two apps the
    rice supports can drive the card.
    """
    if state is not None:
        if state["status"] != "stopped" or state["title"]:
            return state.get("player", "spotify")
        return None
    if spotify_active():
        return "spotify"
    return "bsc" if bsc_active() else None


def music_node_target(player):
    """Resolve an MPRIS player to its own PipeWire output node name."""
    if not player:
        return None
    try:
        proc = subprocess.run(
            ["pw-dump"], stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=3, check=False,
        )
        objects = json.loads(proc.stdout.decode("utf-8", "replace")) if proc.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        objects = []

    def normal(value):
        return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

    wanted = normal(player)
    for obj in objects:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("media.class") != "Stream/Output/Audio":
            continue
        name = str(props.get("node.name") or "")
        for candidate in (name, props.get("application.name"),
                          props.get("media.name")):
            found = normal(candidate)
            if found and (found == wanted or found in wanted or wanted in found):
                return name
    # No discoverable node name: let pw-record try the MPRIS name directly.
    return player


class FlatSeekBar:
    """Cairo progress bar: flat black or white, never a themed blue accent."""

    def __init__(self, area):
        from gi.repository import Gdk, Gtk
        self.area = area
        self.ink = (1.0, 1.0, 1.0)
        self.value = 0.0
        self.length = 0.0
        self.enabled = True
        self.on_seek = None
        self.dragging = False
        self.last_x = 0.0
        area.set_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON1_MOTION_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK)
        area.connect("draw", self.draw)
        area.connect("button-press-event", self.press)
        area.connect("motion-notify-event", self.motion)
        area.connect("button-release-event", self.release)

    def set_ink(self, light):
        self.ink = (0.0, 0.0, 0.0) if light else (1.0, 1.0, 1.0)
        self.area.queue_draw()

    def set_value(self, value):
        self.value = max(0.0, min(1.0, float(value)))
        self.area.queue_draw()

    def set_length(self, length):
        self.length = max(0.0, float(length))

    def set_sensitive(self, enabled):
        self.enabled = bool(enabled)

    def draw(self, _widget, cr):
        width = self.area.get_allocated_width()
        height = self.area.get_allocated_height()
        bar = 4
        top = max(0.0, (height - bar) / 2.0)
        red, green, blue = self.ink
        cr.set_source_rgba(red, green, blue, 0.20)
        cr.rectangle(0, top, width, bar)
        cr.fill()
        cr.set_source_rgb(red, green, blue)
        cr.rectangle(0, top, width * self.value, bar)
        cr.fill()
        return False

    def preview_at(self, x):
        """Move only the bar while dragging; playback waits for the release."""
        width = max(1, self.area.get_allocated_width())
        self.last_x = float(x)
        self.set_value(max(0.0, min(1.0, self.last_x / width)))

    def press(self, _widget, event):
        if not self.enabled or self.length <= 0:
            return False
        self.dragging = True
        self.preview_at(event.x)
        return True

    def motion(self, _widget, event):
        if self.dragging:
            self.preview_at(event.x)
        return True

    def release(self, _widget, event):
        if not self.dragging:
            return False
        self.dragging = False
        self.preview_at(getattr(event, "x", self.last_x))
        if self.enabled and self.length > 0 and self.on_seek is not None:
            self.on_seek(self.value * self.length)
        return True


class FlatVolumeBar:
    """Slim vertical Spotify fader, applied live while dragging.

    Sits on the right edge of the card: higher handle = louder. Unlike the
    old fader, the level is applied continuously during the drag (up raises
    the volume, down lowers it) rather than only on release.
    """

    THROTTLE = 0.05  # seconds between pactl calls while dragging (20 Hz)

    def __init__(self, area):
        from gi.repository import Gdk
        self.area = area
        self.ink = (1.0, 1.0, 1.0)
        self.value = 0.0
        self.on_change = None
        self.dragging = False
        self.last_y = 0.0
        self.last_set = 0.0
        area.set_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON1_MOTION_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.SCROLL_MASK)
        area.connect("draw", self.draw)
        area.connect("button-press-event", self.press)
        area.connect("motion-notify-event", self.motion)
        area.connect("button-release-event", self.release)
        area.connect("scroll-event", self.scroll)

    def set_ink(self, light):
        self.ink = (0.0, 0.0, 0.0) if light else (1.0, 1.0, 1.0)
        self.area.queue_draw()

    def set_value(self, value):
        self.value = max(0.0, min(1.0, float(value)))
        self.area.queue_draw()

    def draw(self, _widget, cr):
        width = self.area.get_allocated_width()
        height = self.area.get_allocated_height()
        bar = 4
        left = max(0.0, (width - bar) / 2.0)
        red, green, blue = self.ink
        cr.set_source_rgba(red, green, blue, 0.20)
        cr.rectangle(left, 0, bar, height)
        cr.fill()
        cr.set_source_rgb(red, green, blue)
        filled = height * self.value
        cr.rectangle(left, height - filled, bar, filled)
        cr.fill()
        return False

    def apply(self, force=False):
        now = time.monotonic()
        if not force and now - self.last_set < self.THROTTLE:
            return
        self.last_set = now
        if self.on_change is not None:
            self.on_change(self.value)

    def preview_at(self, y):
        """Move the fader and apply the new level immediately."""
        height = max(1, self.area.get_allocated_height())
        self.last_y = float(y)
        self.set_value(1.0 - max(0.0, min(1.0, self.last_y / height)))

    def press(self, _widget, event):
        self.dragging = True
        self.preview_at(event.y)
        self.apply(force=True)
        return True

    def motion(self, _widget, event):
        if self.dragging:
            self.preview_at(event.y)
            self.apply()
        return True

    def release(self, _widget, event):
        if not self.dragging:
            return False
        self.dragging = False
        self.preview_at(getattr(event, "y", self.last_y))
        self.apply(force=True)
        return True

    def scroll(self, _widget, event):
        from gi.repository import Gdk
        if event.direction == Gdk.ScrollDirection.UP:
            value = self.value + 0.05
        elif event.direction == Gdk.ScrollDirection.DOWN:
            value = self.value - 0.05
        else:
            return False
        self.set_value(value)
        self.apply(force=True)
        return True


class VinylVisualizer:
    """Rotating vinyl disc with the current cover as its centre label.

    Inspired by the PySide6 turntable in lorenkr/Record (grooves, fixed
    reflection), but drawn directly with the GTK/Cairo context already used by
    the card, so no extra GUI toolkit or Spotify Web API login is needed.
    """

    FPS = 25

    def __init__(self, area):
        self.area = area
        self.surface = None
        self.angle = 0.0
        self.playing = False
        self.running = False
        self.timer = None

    def set_art(self, path):
        """Build a Cairo surface from the cached cover for the centre label."""
        self.surface = None
        if path:
            try:
                from PIL import Image
                size = 256
                image = Image.open(path).convert("RGB").resize((size, size))
                data = bytearray()
                for red, green, blue in image.get_flattened_data():
                    data.extend((blue, green, red, 255))
                self.surface = cairo.ImageSurface.create_for_data(
                    data, cairo.FORMAT_ARGB32, size, size, size * 4
                )
            except Exception:
                self.surface = None
        self.area.queue_draw()

    def set_playing(self, playing):
        self.playing = bool(playing)

    def start(self):
        if self.running:
            return
        self.running = True
        from gi.repository import GLib
        self.timer = GLib.timeout_add(1000 // self.FPS, self._tick)

    def stop(self):
        self.running = False
        if self.timer is not None:
            try:
                from gi.repository import GLib
                GLib.source_remove(self.timer)
            except Exception:
                pass
            self.timer = None
        self.area.queue_draw()

    def _tick(self):
        if not self.running:
            return False
        if self.playing:
            self.angle = (self.angle + 0.018) % (2.0 * math.pi)
            self.area.queue_draw()
        return True

    def draw(self, area, cr):
        width = area.get_allocated_width()
        height = area.get_allocated_height()
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.0)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        center_x, center_y = width / 2.0, height / 2.0
        radius = min(width, height) / 2.0 - 1.0
        if radius <= 4:
            return
        full_turn = 2.0 * math.pi

        # Drop shadow and the vinyl body.
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.45)
        cr.arc(center_x, center_y + 3.0, radius, 0, full_turn)
        cr.fill()
        cr.set_source_rgba(0.045, 0.045, 0.05, 1.0)
        cr.arc(center_x, center_y, radius, 0, full_turn)
        cr.fill()

        # Fine grooves and a brighter outer rim, as on lorenkr/Record.
        for index in range(1, 14):
            groove = radius * (0.48 + index * 0.036)
            if groove >= radius * 0.97:
                break
            cr.set_source_rgba(0.85, 0.85, 0.9,
                               0.09 if index % 3 == 0 else 0.05)
            cr.set_line_width(0.7)
            cr.arc(center_x, center_y, groove, 0, full_turn)
            cr.stroke()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.18)
        cr.set_line_width(1.2)
        cr.arc(center_x, center_y, radius - 1.0, 0, full_turn)
        cr.stroke()

        # The cover art is the label and actually spins with the record.
        label_radius = radius * 0.42
        cr.save()
        cr.translate(center_x, center_y)
        cr.rotate(self.angle)
        cr.arc(0.0, 0.0, label_radius, 0, full_turn)
        cr.clip()
        if self.surface is not None:
            scale = (2.0 * label_radius) / float(self.surface.get_width())
            cr.scale(scale, scale)
            cr.set_source_surface(
                self.surface,
                -self.surface.get_width() / 2.0,
                -self.surface.get_height() / 2.0,
            )
            cr.paint()
        else:
            cr.set_source_rgba(0.22, 0.22, 0.24, 1.0)
            cr.paint()
        cr.restore()

        cr.set_source_rgba(0.0, 0.0, 0.0, 0.55)
        cr.set_line_width(2.0)
        cr.arc(center_x, center_y, label_radius, 0, full_turn)
        cr.stroke()

        # Spindle hole.
        hole = max(3.0, radius * 0.022)
        cr.set_source_rgba(0.0, 0.0, 0.0, 1.0)
        cr.arc(center_x, center_y, hole, 0, full_turn)
        cr.fill()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.25)
        cr.set_line_width(1.0)
        cr.arc(center_x, center_y, hole + 1.0, 0, full_turn)
        cr.stroke()

        # Fixed light reflection sweep (does not rotate with the disc).
        cr.save()
        cr.arc(center_x, center_y, radius - 1.0, 0, full_turn)
        cr.clip()
        shine = cairo.LinearGradient(
            center_x - radius, center_y - radius,
            center_x + radius, center_y + radius,
        )
        shine.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.0)
        shine.add_color_stop_rgba(0.42, 1.0, 1.0, 1.0, 0.0)
        shine.add_color_stop_rgba(0.5, 1.0, 1.0, 1.0, 0.10)
        shine.add_color_stop_rgba(0.58, 1.0, 1.0, 1.0, 0.0)
        shine.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
        cr.set_source(shine)
        cr.rectangle(0, 0, width, height)
        cr.fill()
        cr.restore()

def format_time(seconds):
    seconds = max(0, int(to_float(seconds)))
    hours, remainder = divmod(seconds, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return "%d:%02d:%02d" % (hours, minutes, secs)
    return "%d:%02d" % (minutes, secs)


# MPRIS position is sampled every 250 ms, but the label should track the song
# continuously. Keep the last sample as an anchor and advance it with the
# monotonic clock between samples so the display never lags or drifts.
_position_anchor = {"identity": None, "position": 0.0,
                    "status": "stopped", "at": 0.0}


def track_identity(state):
    """Everything that changes when the song changes, including a seek reset."""
    return (state.get("track_id") or state.get("title"), state.get("artist"),
            state.get("art_url"), state.get("length"))


def anchor_position(position, status=None):
    """Re-anchor immediately after a seek or an external position change."""
    _position_anchor.update(identity=track_identity(read_state()),
                            position=max(0.0, to_float(position)),
                            status=status or _position_anchor["status"],
                            at=time.monotonic())


def synced_position(state):
    """Drift-free playback position from the MPRIS sample in ``state``."""
    now = time.monotonic()
    identity = track_identity(state)
    raw = max(0.0, to_float(state.get("position")))
    status = state.get("status", "stopped")

    predicted = _position_anchor["position"]
    if _position_anchor["status"] == "playing":
        predicted += now - _position_anchor["at"]

    # A new track, a pause/resume or any real seek invalidates the old anchor.
    if (_position_anchor["identity"] != identity or
            _position_anchor["status"] != status or
            abs(raw - predicted) > 1.0):
        _position_anchor.update(identity=identity, position=raw,
                                status=status,
                                at=state.get("sampled_at", now))

    if status == "playing":
        value = _position_anchor["position"] + (now - _position_anchor["at"])
    else:
        value = _position_anchor["position"]

    length = to_float(state.get("length"))
    if length > 0:
        value = min(max(value, 0.0), length)
    return value


