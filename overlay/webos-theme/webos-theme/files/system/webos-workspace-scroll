#!/usr/bin/env bash
# Cycle workspaces 1-5 with Super + mouse wheel.
# Usage: webos-workspace-scroll {down|up}

dir="$1"
cur=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 1')

if ! [[ "$cur" =~ ^[0-9]+$ ]] || (( cur < 1 || cur > 5 )); then
	cur=1
fi

case "$dir" in
	down) next=$(( cur % 5 + 1 )) ;;
	up)   next=$(( (cur + 3) % 5 + 1 )) ;;
	*)    exit 1 ;;
esac

# Handy for testing without actually switching workspaces.
if [[ -n "$DRY_RUN" ]]; then
	echo "$next"
	exit 0
fi

hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = $next }))" >/dev/null
