#!/bin/sh
# webos-fastfetch — WebOS terminal card with the cobweb logo.
# Tries the configured kitty image logo, then the kitty/file fallbacks, then
# the text cobweb so the card always renders.
set -u
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-$LANG}"

CFG=/usr/share/webos/rice/fastfetch/fastfetch.json
LOGO=/usr/share/webos/webos-logo.png
TXT=/usr/share/webos/rice/fastfetch/webos.txt
LOG=/tmp/webos-fastfetch.log
command -v fastfetch >/dev/null 2>&1 || exit 0

fastfetch --config "$CFG" "$@" && exit 0
echo "webos-fastfetch: kitty-direct logo failed, trying kitty" >>"$LOG"
fastfetch --config "$CFG" --logo-type kitty --logo-source "$LOGO" "$@" && exit 0
echo "webos-fastfetch: kitty logo failed, trying file" >>"$LOG"
fastfetch --config "$CFG" --logo-type file --logo-source "$LOGO" "$@" && exit 0
echo "webos-fastfetch: image logos failed, using text cobweb" >>"$LOG"
[ -f "$TXT" ] && exec fastfetch --config "$CFG" --logo-type file --logo-source "$TXT" "$@"
exit 1
