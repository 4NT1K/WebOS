#!/bin/sh
# webos-fastfetch — WebOS terminal card.
# Prints fastfetch with the configured WebOS logo (image in kitty, or text fallback).
set -u

export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-$LANG}"

CFG=/usr/share/webos/rice/fastfetch/fastfetch.json
command -v fastfetch >/dev/null 2>&1 || exit 0

# Image logos (kitty-direct/sixel/etc.) are rendered by fastfetch; don't wrap in a box.
exec fastfetch --config "$CFG" "$@" 2>/dev/null
