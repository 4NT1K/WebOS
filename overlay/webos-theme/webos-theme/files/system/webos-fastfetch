#!/bin/sh
# webos-fastfetch — WebOS terminal card with the cobweb logo in a framed box.
#
# Prefers the user's ~/.config/fastfetch/fastfetch.json, then the system
# fallback. The shipped config uses a plain text logo, because fastfetch is
# built without ImageMagick/chafa support on WebOS: image logo types fail
# with "Image logo types are not supported" (exit 221). A text logo always
# renders, in every terminal and on the bare Linux console.
#
# The card is wrapped in a rounded box ("box bg"): a subtle dark fill and a
# 1-cell border around the text, sized from the widest visible line so ANSI
# colours and the braille logo do not push the border out of alignment.
set -u
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LANG:-C.UTF-8}"

command -v fastfetch >/dev/null 2>&1 || exit 0

CFG_SYS=/usr/share/webos/rice/fastfetch/fastfetch.json
CFG_USER="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/fastfetch.json"
CFG="$CFG_SYS"
[ -f "$CFG_USER" ] && CFG="$CFG_USER"

# The text logo lives next to the config when the user copied it; otherwise
# use the system one.
TXT="$(dirname "$CFG")/webos.txt"
[ -f "$TXT" ] || TXT=/usr/share/webos/rice/fastfetch/webos.txt
LOG=/tmp/webos-fastfetch.log

ESC=$(printf '\033')
strip_ansi() { sed "s/${ESC}\[[0-9;]*m//g"; }
fill() { printf '%*s' "$1" '' | tr ' ' "$2"; }

# Print one fastfetch run inside a box. ANSI colours stay intact; only the
# visible width is used to size the frame and pad shorter lines.
card() {
	out=$1
	width=$(printf '%s\n' "$out" | strip_ansi | wc -L | tr -d ' ')
	case "$width" in ''|0) width=1 ;; esac
	bar=$(fill $((width + 2)) '─')
	printf '\033[38;2;140;140;140m╭%s╮\033[0m\n' "$bar"
	printf '%s\n' "$out" | while IFS= read -r line; do
		vis=$(printf '%s' "$line" | strip_ansi | wc -L | tr -d ' ')
		case "$vis" in ''|*[!0-9]*) vis=0 ;; esac
		pad=$((width - vis))
		[ "$pad" -lt 0 ] && pad=0
		printf '\033[38;2;140;140;140m│\033[0m \033[48;2;18;18;18m%s%*s\033[0m \033[38;2;140;140;140m│\033[0m\n' \
			"$line" "$pad" ''
	done
	printf '\033[38;2;140;140;140m╰%s╯\033[0m\n' "$bar"
}

# First choice: the config as written (text logo). If a user config still
# points at an image type, fall back to the text logo explicitly.
if out=$(fastfetch --config "$CFG" "$@" 2>>"$LOG"); then
	card "$out"
	exit 0
fi
echo "webos-fastfetch: config logo failed, using text cobweb" >>"$LOG"
if [ -f "$TXT" ] && out=$(fastfetch --config "$CFG" --logo-type file --logo-source "$TXT" "$@" 2>>"$LOG"); then
	card "$out"
	exit 0
fi
# Last resort: no logo at all, but still show the system card.
if out=$(fastfetch --config "$CFG" --logo none "$@" 2>>"$LOG"); then
	card "$out"
	exit 0
fi
exit 1
