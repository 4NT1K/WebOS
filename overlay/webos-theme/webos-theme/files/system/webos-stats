#!/usr/bin/env python3
"""WebOS system-monitor overlay (GTK3 + gtk-layer-shell).

Modes:
  --start          launch the hidden daemon if it is not already running
  --toggle         toggle the overlay via SIGUSR1 (start it if necessary)
  --run-hidden     internal: run the daemon with the window hidden
  --run-visible    internal: run the daemon with the window visible

Six progress bars show CPU, GPU, VRAM, RAM, DISK and TEMP, followed by a
CPU chip: dynamic banks of core boxes ("c0  2%") with live usage, Cairo pin
strips, and a centre badge with the hottest package temperature. The number
of banks and boxes adapts to every CPU. RAM shows actual used/total capacity
rather than only a percentage. GPU/VRAM use nvidia-smi when it is present;
without it those rows read "n/a".
"""

import atexit
import glob
import os
import re
import signal
import subprocess
import sys
import tempfile


def runtime_dir():
    path = os.environ.get("XDG_RUNTIME_DIR")
    if not path:
        path = os.path.join(tempfile.gettempdir(), "webos-" + str(os.getuid()))
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except OSError:
        pass
    return path


RUNTIME = runtime_dir()
PIDFILE = os.path.join(RUNTIME, "webos-stats.pid")

LABELS = ("CPU", "GPU", "VRAM", "RAM", "DISK", "TEMP")


def run_quiet(args):
    """Best-effort helper for host commands that may not be installed."""
    try:
        subprocess.run(args, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# process management
# ---------------------------------------------------------------------------

def read_pid():
    try:
        with open(PIDFILE, "r", encoding="utf-8") as handle:
            pid = int(handle.read().strip())
        return pid if pid > 0 else None
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def daemon_running():
    pid = read_pid()
    if pid_alive(pid):
        return pid
    if pid:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
    return None


def write_pidfile():
    with open(PIDFILE, "w", encoding="utf-8") as handle:
        handle.write(str(os.getpid()) + "\n")


def remove_pidfile():
    if read_pid() == os.getpid():
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def hyprctl(*args):
    try:
        proc = subprocess.run(
            ["hyprctl", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", "replace").strip()


def spawn(visible):
    flag = "--run-visible" if visible else "--run-hidden"
    devnull = open(os.devnull, "rb")
    try:
        subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), flag],
            stdin=devnull,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    finally:
        devnull.close()


# ---------------------------------------------------------------------------
# metric collectors
# ---------------------------------------------------------------------------

def clamp(value):
    try:
        value = float(value)
    except (TypeError, ValueError):
        return 0.0
    if value != value:  # NaN
        return 0.0
    return min(1.0, max(0.0, value))


def read_cpu(cpu_id=None):
    """Return (total, idle) jiffies for the aggregate or one cpuN core."""
    key = "cpu" if cpu_id is None else "cpu%d" % cpu_id
    try:
        with open("/proc/stat", "r", encoding="utf-8") as handle:
            for line in handle:
                fields = line.split()
                if not fields or fields[0] != key:
                    continue
                values = [int(x) for x in fields[1:]]
                total = sum(values)
                idle = values[3] + (values[4] if len(values) > 4 else 0)
                return total, idle
    except (OSError, ValueError, IndexError):
        return None
    return None


def read_core_ids():
    """All cpuN IDs present in /proc/stat, so every core gets a row."""
    ids = []
    try:
        with open("/proc/stat", "r", encoding="utf-8") as handle:
            for line in handle:
                fields = line.split()
                if not fields or not fields[0].startswith("cpu"):
                    continue
                suffix = fields[0][3:]
                if suffix.isdigit():
                    ids.append(int(suffix))
    except OSError:
        pass
    return sorted(ids)


def cpu_fraction(previous, current):
    if not previous or not current:
        return 0.0
    total_delta = current[0] - previous[0]
    idle_delta = current[1] - previous[1]
    if total_delta <= 0:
        return 0.0
    return clamp(1.0 - idle_delta / total_delta)


def nvidia_smi():
    """Return (gpu_fraction, vram_fraction, gpu_temp_c) or None."""
    try:
        proc = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu",
                "--format=csv,noheader,nounits",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    line = proc.stdout.decode("utf-8", "replace").splitlines()
    if not line or not line[0].strip():
        return None
    parts = [p.strip() for p in line[0].split(",")]
    if len(parts) < 3:
        return None
    try:
        gpu = float(parts[0]) / 100.0
        used = float(parts[1])
        total = float(parts[2])
        temp = float(parts[3]) if len(parts) > 3 and parts[3] else None
    except ValueError:
        return None
    vram = used / total if total > 0 else 0.0
    return clamp(gpu), clamp(vram), temp


def ram_details():
    """Return (used_fraction, used_GiB, total_GiB) from /proc/meminfo."""
    mem = {}
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                fields = rest.strip().split()
                if fields:
                    mem[key] = float(fields[0])
        total_kib = mem["MemTotal"]
        available_kib = mem.get("MemAvailable", mem.get("MemFree", 0.0))
        if total_kib <= 0:
            return 0.0, 0.0, 0.0
        used_kib = min(total_kib, max(0.0, total_kib - available_kib))
        gib = 1024.0 * 1024.0
        return clamp(used_kib / total_kib), used_kib / gib, total_kib / gib
    except (OSError, ValueError, IndexError, KeyError):
        return 0.0, 0.0, 0.0


def ram_fraction():
    return ram_details()[0]


def disk_fraction():
    try:
        stat = os.statvfs("/")
        total = stat.f_blocks * stat.f_frsize
        available = stat.f_bavail * stat.f_frsize
        if total <= 0:
            return 0.0
        return clamp(1.0 - available / total)
    except OSError:
        return 0.0


def thermal_temp():
    # Prefer real CPU sensors (k10temp/coretemp) over acpitz thermal zones,
    # which on many boards report a stale board temperature instead of the CPU.
    hottest = None
    for path in glob.glob("/sys/class/hwmon/hwmon*/temp*_input"):
        try:
            with open(os.path.join(os.path.dirname(path), "name"), "r", encoding="utf-8") as handle:
                driver = handle.read().strip()
        except OSError:
            continue
        if not re.search(r"k10temp|coretemp|zenpower|cpu", driver, re.I):
            continue
        try:
            with open(path, "r", encoding="utf-8") as handle:
                value = int(handle.read().strip()) / 1000.0
        except (OSError, ValueError):
            continue
        if hottest is None or value > hottest:
            hottest = value
    if hottest is not None:
        return hottest
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                value = int(handle.read().strip()) / 1000.0
        except (OSError, ValueError):
            continue
        if hottest is None or value > hottest:
            hottest = value
    return hottest


def core_temperatures(core_ids, fallback=None):
    """Per-core °C from labelled hwmon/thermal sensors, else the fallback."""
    found = {}

    def temp_from(path):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                return int(handle.read().strip()) / 1000.0
        except (OSError, ValueError):
            return None

    def core_from_label(label):
        match = re.search(r"(?:core|cpu)\s*(\d+)", label, re.IGNORECASE)
        return int(match.group(1)) if match else None

    for pattern in ("/sys/class/hwmon/hwmon*/temp*_input",
                    "/sys/class/hwmon/hwmon*/device/temp*_input"):
        for path in glob.glob(pattern):
            try:
                with open(path.replace("_input", "_label"), "r", encoding="utf-8") as handle:
                    core = core_from_label(handle.read().strip())
            except OSError:
                continue
            if core not in core_ids:
                continue
            temp = temp_from(path)
            if temp is not None:
                found[core] = temp

    for path in glob.glob("/sys/class/thermal/thermal_zone*/type"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                core = core_from_label(handle.read().strip())
        except OSError:
            continue
        if core not in core_ids:
            continue
        temp = temp_from(os.path.join(os.path.dirname(path), "temp"))
        if temp is not None:
            found[core] = temp

    return {core: found.get(core, fallback) for core in core_ids}


def temp_fraction(temp_c):
    if temp_c is None:
        return 0.0
    return clamp(temp_c / 100.0)


def heat_state(temp_c):
    """Grey below 55 °C, amber from 55 °C, red from 75 °C."""
    if temp_c is None:
        return "cool"
    if temp_c >= 75:
        return "hot"
    if temp_c >= 55:
        return "warm"
    return "cool"


# ---------------------------------------------------------------------------
# GTK overlay
# ---------------------------------------------------------------------------

def run_app(visible):
    run_quiet(["hyprctl", "seterror", "disable"])
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    # WebOS ships GtkLayerShell-0.1.typelib; some newer systems expose 1.0.
    # Requesting the wrong version silently falls back to normal toplevel
    # windows, which made the click-catcher appear as an empty box.
    GtkLayerShell = None
    for version in ("0.1", "1.0"):
        try:
            gi.require_version("GtkLayerShell", version)
            from gi.repository import GtkLayerShell
            break
        except (ImportError, ValueError):
            continue

    write_pidfile()
    atexit.register(remove_pidfile)

    CSS = """
    #webos-stats-catcher, #webos-stats-catcher-area {
        background-color: transparent;
    }
    #stats-card {
        background-color: rgba(0, 0, 0, 0.92);
        border: 1px solid rgba(232, 232, 232, 0.20);
        border-radius: 18px;
        color: #D8D8D8;
        padding: 12px;
    }
    progressbar, progressbar trough {
        background-color: rgba(232, 232, 232, 0.08);
        border-radius: 6px;
        min-height: 12px;
    }
    progressbar progress {
        background-color: #E8E8E8;
        border-radius: 6px;
    }
    progressbar {
        font: 11px "JetBrains Mono", "DejaVu Sans Mono", monospace;
        color: #D8D8D8;
    }
    /* CPU chip: grey under 55 °C, amber 55–75 °C, red at 75 °C and up. */
    #chip-frame {
        border: 1px solid rgba(232, 232, 232, 0.35);
        border-radius: 8px;
        padding: 4px;
    }
    #chip-frame.warm { border-color: rgba(251, 191, 36, 0.85); }
    #chip-frame.hot  { border-color: rgba(248, 113, 113, 0.95); }
    #chip-core {
        min-width: 26px;
        min-height: 24px;
        border: 1px solid rgba(232, 232, 232, 0.28);
        border-radius: 4px;
        color: #D8D8D8;
        font: 11px "JetBrains Mono", "DejaVu Sans Mono", monospace;
    }
    #chip-core.warm {
        border-color: rgba(251, 191, 36, 0.85);
        color: #FBBF24;
    }
    #chip-core.hot {
        border-color: rgba(248, 113, 113, 0.95);
        color: #F87171;
    }
    #chip-temp {
        min-width: 70px;
        color: #E8E8E8;
        font: 13px "JetBrains Mono", "DejaVu Sans Mono", monospace;
    }
    #chip-temp.warm { color: #FBBF24; }
    #chip-temp.hot  { color: #F87171; }
    #chip-pins { min-height: 8px; }
    """

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    # Transparent fullscreen surface behind the card: clicking outside the
    # card dismisses the dropdown (Wayland has no global click grab).
    fallback_geometry = None
    catcher = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    catcher.set_title("webos-stats-outside")
    catcher.set_decorated(False)
    catcher.set_skip_taskbar_hint(True)
    catcher.set_skip_pager_hint(True)
    catcher.set_app_paintable(True)
    # Keep the surface hit-testable but completely invisible; a transparent
    # GTK background can otherwise arrive as an opaque dark Wayland buffer.
    catcher.set_opacity(0.0)
    catcher.set_name("webos-stats-catcher")
    rgba_screen = Gdk.Screen.get_default()
    rgba_visual = rgba_screen.get_rgba_visual() if rgba_screen else None
    if rgba_visual is not None:
        catcher.set_visual(rgba_visual)
    if GtkLayerShell is not None:
        GtkLayerShell.init_for_window(catcher)
        GtkLayerShell.set_layer(catcher, GtkLayerShell.Layer.TOP)
        for edge in ("LEFT", "RIGHT", "TOP", "BOTTOM"):
            GtkLayerShell.set_anchor(catcher, getattr(GtkLayerShell.Edge, edge), True)
            GtkLayerShell.set_margin(catcher, getattr(GtkLayerShell.Edge, edge), 0)
        GtkLayerShell.set_exclusive_zone(catcher, -1)
        try:
            GtkLayerShell.set_namespace(catcher, "webos-stats-outside")
        except AttributeError:
            pass
    else:
        # The live session often has no gtk-layer-shell introspection and no
        # "primary" GDK monitor. Use monitor 0 so the click-catcher covers the
        # whole screen instead of appearing as a 200x200 empty window.
        display = Gdk.Display.get_default()
        monitor = None
        if display is not None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor is not None:
            geometry = monitor.get_geometry()
            fallback_geometry = geometry
            catcher.set_default_size(geometry.width, geometry.height)
            catcher.move(geometry.x, geometry.y)
        catcher.set_keep_below(True)
    catcher_area = Gtk.EventBox()
    catcher_area.set_name("webos-stats-catcher-area")
    catcher.add(catcher_area)

    window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    window.set_title("webos-stats")
    window.set_decorated(False)
    window.set_resizable(False)
    window.set_skip_taskbar_hint(True)
    window.set_skip_pager_hint(True)
    core_ids = read_core_ids()
    # Two banks by default; only wide CPUs need more. Every logical CPU gets
    # exactly one box, so an 18-core chip shows 18 boxes (two banks of nine).
    bank_count = min(len(core_ids), max(2, (len(core_ids) + 15) // 16)) if core_ids else 1
    base, extra = divmod(len(core_ids), bank_count)
    banks, start = [], 0
    for index in range(bank_count):
        size = base + (1 if index < extra else 0)
        banks.append(core_ids[start:start + size])
        start += size
    columns = max((len(bank) for bank in banks), default=0)
    win_width = max(280, columns * 28 + 96)
    # Let GTK size to the content. A fixed height leaves dead space under the
    # chip when the CPU has fewer logical cores than the widest layout.
    window.set_default_size(win_width, -1)
    window.set_app_paintable(True)
    if rgba_visual is not None:
        window.set_visual(rgba_visual)
    if GtkLayerShell is None:
        window.set_transient_for(catcher)
        window.set_keep_above(True)

    if GtkLayerShell is not None:
        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.LEFT, False)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(window, GtkLayerShell.Edge.TOP, 100)
        GtkLayerShell.set_margin(window, GtkLayerShell.Edge.RIGHT, 12)
        GtkLayerShell.set_exclusive_zone(window, -1)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    card.set_name("stats-card")
    window.add(card)

    bars = {}
    for label in LABELS:
        bar = Gtk.ProgressBar()
        bar.set_show_text(True)
        bar.set_text("%s   n/a" % label)
        bar.set_fraction(0.0)
        card.pack_start(bar, False, False, 0)
        bars[label] = bar

    heat = ["cool"]
    pin_area = []

    def draw_pins(area, cr):
        width = float(area.get_allocated_width())
        height = float(area.get_allocated_height())
        color = {
            "cool": (0.75, 0.75, 0.75, 0.85),
            "warm": (0.98, 0.75, 0.14, 0.90),
            "hot": (0.97, 0.44, 0.44, 0.95),
        }[heat[0]]
        cr.set_source_rgba(*color)
        count = max(columns + 1, 2)
        for index in range(count):
            x = 2 + index * (width - 4) / (count - 1)
            cr.rectangle(x - 1.5, 0, 3, height)
        cr.fill()

    chip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    chip.set_name("chip-frame")
    card.pack_start(chip, False, False, 2)

    pins_top = Gtk.DrawingArea()
    pins_top.set_name("chip-pins")
    pins_top.connect("draw", draw_pins)
    chip.pack_start(pins_top, False, False, 0)

    chip_body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    chip_body.set_homogeneous(False)
    chip.pack_start(chip_body, False, False, 0)

    core_labels = {}
    temp_label = Gtk.Label()
    temp_label.set_name("chip-temp")
    temp_label.set_markup("<small>PKG TEMP</small>\n<b>n/a</b>")

    for index, bank in enumerate(banks):
        if index == len(banks) // 2:
            chip_body.pack_start(temp_label, False, False, 4)
        grid = Gtk.Grid()
        grid.set_column_spacing(3)
        grid.set_row_spacing(3)
        for column, core in enumerate(bank):
            label = Gtk.Label()
            label.set_name("chip-core")
            label.set_justify(Gtk.Justification.CENTER)
            label.set_markup("<small>c%d</small>\n<b>n/a</b>" % core)
            grid.attach(label, column, 0, 1, 1)
            core_labels[core] = label
        chip_body.pack_start(grid, False, False, 0)
    if len(banks) // 2 >= len(banks):
        chip_body.pack_start(temp_label, False, False, 4)

    pins_bottom = Gtk.DrawingArea()
    pins_bottom.set_name("chip-pins")
    pins_bottom.connect("draw", draw_pins)
    chip.pack_start(pins_bottom, False, False, 0)
    pin_area.extend([pins_top, pins_bottom])

    cpu_previous = [read_cpu()]
    cpu_previous_cores = {core: read_cpu(core) for core in core_ids}
    nvidia_present = [True]

    def poll():
        nvidia = nvidia_smi() if nvidia_present[0] else None
        if nvidia_present[0] and nvidia is None:
            nvidia_present[0] = False

        current = read_cpu()
        ram_frac, ram_used, ram_total = ram_details()
        values = {
            "CPU": cpu_fraction(cpu_previous[0], current),
            "GPU": nvidia[0] if nvidia else None,
            "VRAM": nvidia[1] if nvidia else None,
            "RAM": ram_frac,
            "DISK": disk_fraction(),
        }
        cpu_previous[0] = current or cpu_previous[0]

        zone_temp = thermal_temp()
        temp_c = zone_temp if zone_temp is not None else (nvidia[2] if nvidia else None)
        values["TEMP"] = temp_fraction(temp_c)

        for label in LABELS:
            value = values[label]
            bar = bars[label]
            if value is None:
                bar.set_fraction(0.0)
                bar.set_text("%s   n/a" % label)
            else:
                fraction = clamp(value)
                bar.set_fraction(fraction)
                suffix = "%d%%" % round(fraction * 100)
                if label == "TEMP" and temp_c is not None:
                    suffix = "%dC" % int(round(temp_c))
                if label == "RAM" and ram_total > 0:
                    suffix = "%.1fG used / %.1fG" % (ram_used, ram_total)
                bar.set_text("%s   %s" % (label, suffix))

        for core in core_ids:
            current_core = read_cpu(core)
            usage = cpu_fraction(cpu_previous_cores.get(core), current_core)
            if current_core:
                cpu_previous_cores[core] = current_core
            label = core_labels[core]
            label.set_markup("<small>c%d</small>\n<b>%d%%</b>" % (core, round(usage * 100)))

        temp_text = "%d°C" % int(round(temp_c)) if temp_c is not None else "n/a"
        temp_label.set_markup("<small>PKG TEMP</small>\n<b>%s</b>" % temp_text)

        state = heat_state(temp_c)
        if state != heat[0]:
            heat[0] = state
            for widget in [chip, temp_label, *core_labels.values()]:
                context = widget.get_style_context()
                context.remove_class("cool")
                context.remove_class("warm")
                context.remove_class("hot")
                context.add_class(state)
            for area in pin_area:
                area.queue_draw()
        return True

    def place_fallback():
        """Top-right placement when gtk-layer-shell is unavailable."""
        if GtkLayerShell is not None or fallback_geometry is None:
            return
        x = fallback_geometry.x + fallback_geometry.width - win_width - 12
        y = fallback_geometry.y + 42
        hyprctl("dispatch", "hl.dsp.window.move({ x = %d, y = %d })" % (x, y))

    def hide_dropdown():
        window.hide()
        catcher.hide()
        return False

    catcher_area.connect(
        "button-press-event", lambda *_: GLib.idle_add(hide_dropdown)
    )

    def toggle_visibility():
        if window.get_visible():
            hide_dropdown()
        else:
            catcher.show_all()
            if GtkLayerShell is None:
                catcher.fullscreen()
            window.show_all()
            place_fallback()
        return False

    def on_sigusr1(_signum, _frame):
        GLib.idle_add(toggle_visibility)

    def on_stop(_signum, _frame):
        GLib.idle_add(Gtk.main_quit)

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)

    poll()
    GLib.timeout_add(2000, poll)

    if visible:
        catcher.show_all()
        if GtkLayerShell is None:
            catcher.fullscreen()
        window.show_all()
        place_fallback()
    window.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


def main(argv):
    options = set(arg for arg in argv if arg.startswith("--"))
    if len(options) != 1 or not options <= {"--start", "--toggle", "--run-hidden", "--run-visible"}:
        print("usage: webos-stats {--start|--toggle|--run-hidden|--run-visible}", file=sys.stderr)
        return 2
    mode = next(iter(options))

    if mode == "--run-hidden":
        return run_app(False)
    if mode == "--run-visible":
        return run_app(True)

    pid = daemon_running()
    if mode == "--start":
        if pid is None:
            spawn(False)
        return 0

    if pid is None:
        spawn(True)
    else:
        try:
            os.kill(pid, signal.SIGUSR1)
        except OSError:
            spawn(False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
