#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  webos-gaming — one entry point for the gaming knobs.
#
#    webos-gaming status              what is running, and with what
#    webos-gaming gamescope [cmd…]    run a command inside a gamescope session
#    webos-gaming gamescope-session   a SteamOS-style gamescope + Steam session
#    webos-gaming mangohud-toggle     flip MangoHud on/off
#    webos-gaming proton install      fetch the newest Proton-GE into Steam
#    webos-gaming proton list         list installed Proton builds
#    webos-gaming tune <profile>      apply a scx/cpu profile (see below)
#    webos-gaming bench <cmd…>        run a command with MangoHud + logging
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

CMD="${1:-status}"
shift || true

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/webos"
mkdir -p "$STATE_DIR"

# ── status ──────────────────────────────────────────────────────────────────
status() {
	printf 'WebOS gaming status\n'
	printf '%s\n' "─────────────────────"

	printf '%-14s %s\n' "kernel" "$(uname -r)"
	printf '%-14s %s\n' "cpu"    "$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo)"
	printf '%-14s %s\n' "governor" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
	printf '%-14s %s\n' "epp" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"

	printf '%-14s %s\n' "gpu" "$(lspci 2>/dev/null | awk -F': ' '/VGA|3D controller/{printf "%s ", $2} END{print ""}')"

	if [[ -r /sys/kernel/mm/lru_gen/enabled ]]; then
		printf '%-14s %s\n' "mglru" "$(cat /sys/kernel/mm/lru_gen/enabled)"
	fi
	printf '%-14s %s\n' "zram" "$(swapon --show=NAME,SIZE --noheadings 2>/dev/null | tr '\n' ' ' || echo none)"

	printf '%-14s %s\n' "gamemode" "$(pgrep -x gamemoded >/dev/null && echo running || echo stopped)"
	printf '%-14s %s\n' "mangohud" "$([[ -f "$STATE_DIR/mangohud" ]] && echo on || echo off)"
	printf '%-14s %s\n' "gamescope" "$(command -v gamescope >/dev/null && gamescope --version 2>&1 | head -n1 || echo not installed)"

	if command -v scxctl >/dev/null 2>&1; then
		printf '%-14s %s\n' "sched-ext" "$(scxctl list 2>/dev/null | head -n1 || echo n/a)"
	fi

	printf '\nSteam libraries:\n'
	if [[ -f "$HOME/.steam/steam/steamapps/libraryfolders.vdf" ]]; then
		grep -oE '"/[^"]+"' "$HOME/.steam/steam/steamapps/libraryfolders.vdf" 2>/dev/null | tr -d '"' | sed 's/^/  /'
	else
		printf '  (Steam has not been run yet)\n'
	fi
}

# ── gamescope ───────────────────────────────────────────────────────────────
gamescope_run() {
	command -v gamescope >/dev/null 2>&1 || { echo "gamescope is not installed" >&2; exit 1; }
	local inner=("$@")
	[[ ${#inner[@]} -eq 0 ]] && inner=(kitty)
	exec gamescope \
		--rt \
		--adaptive-sync \
		--mangoapp \
		--hdr-enabled \
		--fullscreen \
		-e \
		-- "${inner[@]}"
}

gamescope_session() {
	# A console-like session: gamescope on top, Steam inside it, exactly the
	# shape of a Steam Deck. Handy as a second session at the greeter.
	command -v gamescope >/dev/null 2>&1 || { echo "gamescope is not installed" >&2; exit 1; }
	if ! command -v steam >/dev/null 2>&1; then
		exec gamescope --rt --fullscreen -e -- kitty
	fi
	export STEAM_ENABLE_GAMESCOPE=1
	export SDL_VIDEODRIVER=wayland
	export XDG_CURRENT_DESKTOP=gamescope
	exec gamescope \
		--rt --adaptive-sync --mangoapp --hdr-enabled \
		--steam --fullscreen \
		-e -- steam -gamepadui
}

# ── MangoHud toggle ─────────────────────────────────────────────────────────
mangohud_toggle() {
	local flag="$STATE_DIR/mangohud"
	if [[ -f "$flag" ]]; then
		rm -f "$flag"
		unset MANGOHUD 2>/dev/null || true
		echo "MangoHud: off (new launches)"
	else
		: > "$flag"
		echo "MangoHud: on (new launches)"
	fi
	echo "Steam: right-click a game -> Properties -> Launch Options:"
	echo "  mangohud %command%"
}

# ── Proton-GE ───────────────────────────────────────────────────────────────
proton_dir() {
	local base="$HOME/.steam/steam/compatibilitytools.d"
	[[ -d "$HOME/.local/share/Steam" ]] && base="$HOME/.local/share/Steam/compatibilitytools.d"
	printf '%s' "$base"
}

proton_install() {
	command -v curl >/dev/null 2>&1 || { echo "curl is required" >&2; exit 1; }
	command -v jq   >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

	local dest; dest="$(proton_dir)"
	mkdir -p "$dest"

	echo "Looking up the newest Proton-GE release…"
	local api="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
	local url tag
	tag="$(curl -fsSL "$api" | jq -r '.tag_name')"
	url="$(curl -fsSL "$api" | jq -r '.assets[] | select(.name | endswith(".tar.gz")) | .browser_download_url' | head -n1)"
	[[ -n "$url" ]] || { echo "could not find a Proton-GE tarball" >&2; exit 1; }

	echo "Installing $tag into $dest"
	local tmp; tmp="$(mktemp -d)"
	curl -fL --progress-bar -o "$tmp/ge.tar.gz" "$url"
	tar -xzf "$tmp/ge.tar.gz" -C "$dest"
	rm -rf "$tmp"
	echo "Done. Restart Steam, then set the compatibility tool per game."
}

proton_list() {
	local dest; dest="$(proton_dir)"
	[[ -d "$dest" ]] || { echo "no compatibility tools installed"; return 0; }
	find "$dest" -maxdepth 1 -mindepth 1 -type d -printf '  %f\n' | sort
}

# ── tuning ──────────────────────────────────────────────────────────────────
tune() {
	local profile="${1:-balanced}"
	command -v cpupower >/dev/null 2>&1 && {
		case "$profile" in
			performance) sudo cpupower frequency-set -g performance ;;
			powersave)   sudo cpupower frequency-set -g powersave ;;
			balanced)    sudo cpupower frequency-set -g schedutil ;;
		esac
	}

	if command -v scxctl >/dev/null 2>&1; then
		case "$profile" in
			performance) sudo scxctl start scx_lavd -- --performance ;;
			balanced)    sudo scxctl start scx_bpfland ;;
			powersave)   sudo scxctl start scx_lavd -- --powersave ;;
		esac
	fi

	if [[ -w /sys/kernel/mm/transparent_hugepage/enabled ]]; then
		case "$profile" in
			performance) echo always | sudo tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null ;;
			*)           echo madvise | sudo tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null ;;
		esac
	fi

	echo "Profile '${profile}' applied."
}

bench() {
	command -v mangohud >/dev/null 2>&1 || { echo "mangohud is not installed" >&2; exit 1; }
	local log="${STATE_DIR}/bench-$(date +%Y%m%d-%H%M%S).csv"
	MANGOHUD=1 MANGOHUD_CONFIG="output_folder=${log%/*},log_duration=0,fps_only=0" \
		gamemoderun "$@"
	echo "Log: $log"
}

case "$CMD" in
	status)             status ;;
	gamescope)          gamescope_run "$@" ;;
	gamescope-session)  gamescope_session ;;
	mangohud-toggle)    mangohud_toggle ;;
	proton)             "proton_${1:-list}" ;;
	tune)               tune "$@" ;;
	bench)              bench "$@" ;;
	-h|--help|help)
		sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) printf 'webos-gaming: unknown command %s\n' "$CMD" >&2; exit 1 ;;
esac
