#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  webos-shot — screenshots on Wayland, the WebOS way.
#
#    webos-shot region  [--clipboard|--save]   select an area
#    webos-shot window  [--clipboard|--save]   the focused window
#    webos-shot output  [--clipboard|--save]   the focused monitor
#    webos-shot full    [--clipboard|--save]   everything
#    webos-shot --dir                          print the save directory
#
#  Saves to ~/Pictures/Screenshots and, with --clipboard, also to the
#  clipboard. A notification tells you where the file went.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

SHOT_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
TARGET="region"
DEST="both"

for arg in "$@"; do
	case "$arg" in
		region|window|output|full) TARGET="$arg" ;;
		--clipboard) DEST="clipboard" ;;
		--save)      DEST="save" ;;
		--dir)       printf '%s\n' "$SHOT_DIR"; exit 0 ;;
		--help|-h)   sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*)           printf 'webos-shot: unknown argument %s\n' "$arg" >&2; exit 1 ;;
	esac
done

need() { command -v "$1" >/dev/null 2>&1 || { printf 'webos-shot: %s is required\n' "$1" >&2; exit 1; }; }
need grim

mkdir -p "$SHOT_DIR"
FILE="${SHOT_DIR}/$(date +%Y-%m-%d_%H-%M-%S)-${TARGET}.png"

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -a "Screenshot" -i "$1" -h string:x-canonical-private-synchronous:shot "$2" "${3:-}"
}

case "$TARGET" in
	region)
		need slurp
		# Translucent WebOS dim + a crisp white box so the selection is clear.
		GEOM="$(slurp -b '#14141a14' -s '#00000000' -c '#e8e8e8ff' -w 2 -d)" || exit 0
		sleep 0.4
		grim -g "$GEOM" "$FILE"
		;;
	window)
		need jq
		need hyprctl
		GEOM="$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
		[[ "$GEOM" == "null" || -z "$GEOM" ]] && { notify dialog-warning "No focused window"; exit 1; }
		grim -g "$GEOM" "$FILE"
		;;
	output)
		need jq
		need hyprctl
		out=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name' | head -n 1)
		[[ -n "$out" ]] || { notify dialog-warning "No focused monitor"; exit 1; }
		grim -o "$out" "$FILE"
		;;
	full)
		grim "$FILE"
		;;
esac

[[ -s "$FILE" ]] || { notify dialog-error "Screenshot failed"; exit 1; }

if [[ "$DEST" == "clipboard" || "$DEST" == "both" ]]; then
	if command -v wl-copy >/dev/null 2>&1; then
		wl-copy --type image/png < "$FILE"
	fi
fi

case "$DEST" in
	clipboard) rm -f "$FILE"; notify edit-copy "Copied to clipboard" ;;
	save)      notify camera-photo "Saved" "$FILE" ;;
	both)      notify camera-photo "Saved and copied" "$FILE" ;;
esac
