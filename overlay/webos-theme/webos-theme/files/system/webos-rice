#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  webos-rice — apply the WebOS look to a home directory.
#
#    webos-rice --user            apply to $HOME
#    webos-rice --system          apply to /etc/skel, /root and every /home/*
#    webos-rice --ensure          install only missing rice files
#    webos-rice --check           dry run: report what would change
#    webos-rice --force           overwrite files you have modified
#    webos-rice --doctor          verify the running environment
#    webos-rice --toggle-panel    show/hide waybar
#    webos-rice --list            list the managed trees
#    webos-rice --wallpaper <img>  set the Hyprland wallpaper
#
#  It never clobbers a file it did not write. Every file it installs is
#  recorded with its hash in $XDG_STATE_HOME/webos/rice.manifest; if the hash on
#  disk no longer matches, the file is considered yours and is left alone.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

readonly RICE_SRC="/usr/share/webos/rice"
readonly WALL_DIR="/usr/share/webos/wallpaper"
readonly VERSION="1.021"

MODE="user"
FORCE=0
QUIET=0
DRY_RUN=0
WALLPAPER=""
WALLPAPER_DIR="/usr/share/webos/wallpaper"

# ── output ──────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
	C_R=$'\033[0m'; C_D=$'\033[2m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_B=$'\033[34m'; C_E=$'\033[31m'
else
	C_R=; C_D=; C_G=; C_Y=; C_B=; C_E=
fi
say()  { (( QUIET )) || printf '%s\n' "$*"; }
note() { (( QUIET )) || printf '%s  ->%s %s\n' "$C_B" "$C_R" "$*"; }
skip() { (( QUIET )) || printf '%swarn%s %s\n' "$C_Y" "$C_R" "$*"; }
done_() { (( QUIET )) || printf '%s  ok%s %s\n' "$C_G" "$C_R" "$*"; }
die()  { printf '%sfail%s %s\n' "$C_E" "$C_R" "$*" >&2; exit 1; }

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

# ── what we manage ──────────────────────────────────────────────────────────
# rice subdirectory  ->  path under $HOME
declare -A TREES=(
	[hypr]=".config/hypr"
	[waybar]=".config/waybar"
	[wofi]=".config/wofi"
	[mako]=".config/mako"
	[foot]=".config/foot"
	[kitty]=".config/kitty"
	[fish]=".config/fish"
	[wlogout]=".config/wlogout"
	[gtk-3.0]=".config/gtk-3.0"
	[gtk-4.0]=".config/gtk-4.0"
	[fastfetch]=".config/fastfetch"
	[qt5ct]=".config/qt5ct"
	[qt6ct]=".config/qt6ct"
	[kvantum]=".config/Kvantum"
	[color-schemes]=".local/share/color-schemes"
	[konsole]=".local/share/konsole"
)

sha() { sha256sum "$1" | cut -d' ' -f1; }

state_dir()  { printf '%s/.local/state/webos' "$1"; }
manifest_of(){ printf '%s/rice.manifest' "$(state_dir "$1")"; }

recorded_hash() {
	# $1 = manifest file, $2 = absolute path
	[[ -f "$1" ]] || return 1
	awk -v p="$2" '$2 == p { print $1; found=1 } END { exit(found?0:1) }' "$1"
}

record() {
	# $1 = manifest file, $2 = absolute path, $3 = hash
	local mf="$1" path="$2" hash="$3" tmp
	(( DRY_RUN )) && return 0
	mkdir -p "$(dirname "$mf")"
	tmp="$(mktemp)"
	if [[ -f "$mf" ]]; then
		awk -v p="$path" '$2 != p' "$mf" > "$tmp"
	fi
	printf '%s %s\n' "$hash" "$path" >> "$tmp"
	mv -f "$tmp" "$mf"
}

prune_manifest() {
	# 1.021 shipped hyprland.conf/webos-colors.conf; their hashes stayed in
	# rice.manifest forever. Drop those obsolete entries on every apply so
	# --doctor and --check do not report files that no longer exist.
	local mf="$1" tmp
	(( DRY_RUN )) && return 0
	[[ -f "$mf" ]] || return 0
	tmp="$(mktemp)"
	awk 'NF >= 2 && $2 !~ /(hyprland\.conf|webos-colors\.conf)$/ { print }' "$mf" > "$tmp"
	if ! cmp -s "$mf" "$tmp"; then
		mv -f "$tmp" "$mf"
		note "pruned obsolete rice manifest entries"
	else
		rm -f "$tmp"
	fi
}

backup_once() {
	local f="$1"
	(( DRY_RUN )) && return 0
	[[ -f "$f" ]] || return 0
	[[ -f "$f.webos-orig" ]] && return 0
	cp -a "$f" "$f.webos-orig"
	note "backed up $f -> $f.webos-orig"
}

# The installer seeds ~/.config/waybar from the "mono" dotfiles profile, not
# from RICE_SRC. Up to webos-theme-1.0-r1 that profile shipped a Waybar config
# with no custom/power pill, so those files are not in our manifest and
# install_file() treats them as user edits. Upgrade only the exact known
# distro-generated hashes; anything genuinely modified by the user is left
# alone. This makes `webos-update` restore the ⏻ widget on existing installs.
migrate_legacy_waybar() {
	local home="$1" mf cfg sty new_cfg new_sty
	local old_cfg="2b3fc6c9c3f0d46bcebebdff9787054cf117e6cba2936505a19ba3de6e978081"
	local old_sty="13c685e3dfebdee222b3ebe5a5ae75da8486f5a6e8bf9d659fd01500b46a2ac1"
	mf="$(manifest_of "$home")"
	cfg="$home/.config/waybar/config.jsonc"
	sty="$home/.config/waybar/style.css"
	new_cfg="${RICE_SRC}/waybar/config.jsonc"
	new_sty="${RICE_SRC}/waybar/style.css"
	[[ -f "$new_cfg" && -f "$new_sty" ]] || return 0

	if [[ -f "$cfg" && "$(sha "$cfg")" == "$old_cfg" ]]; then
		if (( DRY_RUN )); then
			say "would migrate legacy mono Waybar config ${cfg/#$HOME/~}"
		else
			backup_once "$cfg"
			install -m 0644 "$new_cfg" "$cfg"
			record "$mf" "$cfg" "$(sha "$new_cfg")"
			note "migrated legacy mono Waybar config ${cfg/#$HOME/~}"
		fi
	fi

	if [[ -f "$sty" && "$(sha "$sty")" == "$old_sty" ]]; then
		if (( DRY_RUN )); then
			say "would migrate legacy mono Waybar style ${sty/#$HOME/~}"
		else
			backup_once "$sty"
			install -m 0644 "$new_sty" "$sty"
			record "$mf" "$sty" "$(sha "$new_sty")"
			note "migrated legacy mono Waybar style ${sty/#$HOME/~}"
		fi
	fi
}

install_file() {
	# $1 = source, $2 = destination, $3 = manifest, $4 = force, $5 = dry-run
	local src="$1" dst="$2" mf="$3" force="$4" dry="${5:-$DRY_RUN}"
	local new old rec mode label
	label="${dst/#$HOME/~}"

	new="$(sha "$src")"
	(( dry )) || mkdir -p "$(dirname "$dst")"

	if [[ ! -e "$dst" ]]; then
		if (( dry )); then
			say "would install ${label}"
			return 0
		fi
		mode="$(stat -c '%a' "$src")"
		install -m "$mode" "$src" "$dst"
		record "$mf" "$dst" "$new"
		return 0
	fi

	old="$(sha "$dst")"
	if [[ "$old" == "$new" ]]; then
		(( dry )) || record "$mf" "$dst" "$new"
		return 0
	fi

	if rec="$(recorded_hash "$mf" "$dst")" && [[ "$old" == "$rec" ]]; then
		# Ours, untouched by the user: update it.
		if (( dry )); then
			say "would update ${label}"
			return 0
		fi
		mode="$(stat -c '%a' "$src")"
		install -m "$mode" "$src" "$dst"
		record "$mf" "$dst" "$new"
		return 0
	fi

	if (( force )); then
		if (( dry )); then
			say "would update (force) ${label}"
			return 0
		fi
		backup_once "$dst"
		mode="$(stat -c '%a' "$src")"
		install -m "$mode" "$src" "$dst"
		record "$mf" "$dst" "$new"
		return 0
	fi

	skip "kept your version: ${label}"
	return 0
}

apply_tree() {
	# $1 = home, $2 = force, $3 = dry-run
	local home="$1" force="$2" dry="$3" mf sub src dst f rel
	mf="$(manifest_of "$home")"
	for sub in "${!TREES[@]}"; do
		src="${RICE_SRC}/${sub}"
		[[ -d "$src" ]] || continue
		dst="${home}/${TREES[$sub]}"
		while IFS= read -r -d '' f; do
			rel="${f#"$src"/}"
			install_file "$f" "${dst}/${rel}" "$mf" "$force" "$dry"
		done < <(find "$src" -type f -print0)
	done
}

apply_web_themes() {
	# $1 = home, $2 = force, $3 = dry-run
	local home="$1" force="$2" dry="$3" mf profile pref theme ini
	mf="$(manifest_of "$home")"
	for profile in "$home"/.config/mozilla/firefox/*.default*; do
		[[ -d "$profile" ]] || continue
		mkdir -p "$profile/chrome"
		install_file "${RICE_SRC}/firefox/userChrome.css" "$profile/chrome/userChrome.css" "$mf" "$force" "$dry"
		install_file "${RICE_SRC}/firefox/userContent.css" "$profile/chrome/userContent.css" "$mf" "$force" "$dry"
		install_file "${RICE_SRC}/firefox/user.js" "$profile/user.js" "$mf" "$force" "$dry"
		pref="$profile/prefs.js"
		if [[ -f "$pref" ]] && ! grep -q 'toolkit.legacyUserProfileCustomizations.stylesheets' "$pref"; then
			(( dry )) || echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >> "$pref"
		fi
	done
	if [[ -d "$home/.local/share/applications" ]]; then
		install_file "${RICE_SRC}/applications/com.github.wwmm.easyeffects.desktop" \
			"$home/.local/share/applications/com.github.wwmm.easyeffects.desktop" "$mf" "$force" "$dry"
	fi
	install_file "${RICE_SRC}/spotify/spotify" "$home/.local/bin/spotify" "$mf" "$force" "$dry"
	# Vesktop was removed from the image; drop the launcher and wrapper left
	# by older rice versions. Keep a Hidden=true stub: that is how the
	# root-owned system entry is suppressed until the package is unmerged.
	(( dry )) || {
		rm -f "$home/.local/bin/vesktop"
		vs_launcher="$home/.local/share/applications/vesktop.desktop"
		if [[ -f "$vs_launcher" ]] && grep -q '^Exec=.*\.local/bin/vesktop' "$vs_launcher"; then
			rm -f "$vs_launcher"
		fi
	}
	ini="$home/.config/spicetify/config-xpui.ini"
	[[ -f "$ini" ]] || return 0
	theme="$(sed -n 's/^current_theme[[:space:]]*=[[:space:]]*//p' "$ini" | head -1)"
	[[ -n "$theme" ]] || return 0
	install_file "${RICE_SRC}/spicetify/user.css" "$home/.config/spicetify/Themes/$theme/user.css" "$mf" "$force" "$dry"
}

apply_home() {
	# $1 = home, $2 = force, $3 = dry-run
	local home="$1" force="$2" dry="$3"
	[[ -d "$home" ]] || return 0
	if (( dry )); then
		note "dry run for ${home}"
	else
		note "applying rice to ${home}"
	fi
	local mf lua conf rec
	mf="$(manifest_of "$home")"
	prune_manifest "$mf"

	# Fresh installs get their Waybar files from the mono dotfiles profile.
	# Bring old installs forward before apply_tree() so the power pill returns
	# on the next `webos-update` without clobbering user-modified configs.
	migrate_legacy_waybar "$home"

	# Hyprland 0.57+ reads ~/.config/hypr/hyprland.lua and ignores
	# hyprland.conf. A home that was first themed by an older release (or by
	# the Hyprland package itself) may still have the upstream *example* lua.
	# That example has no WebOS autostart, so it silently disables the bar,
	# portals and wallpaper. Replace only that untouched example — a config
	# the user edited is left alone, exactly like every other rice file.
	lua="$home/.config/hypr/hyprland.lua"
	if [[ -f "$lua" ]] && grep -q '^-- This is an example Hyprland Lua config file\.' "$lua" 2>/dev/null; then
		if (( dry )); then
			say "would remove upstream example ${lua/#$HOME/~}"
		else
			backup_once "$lua"
			rm -f "$lua"
		fi
	fi

	# hyprland.conf is dead config on 0.57. Remove our own copy so nobody
	# edits a file the compositor never reads; keep a user-modified one.
	conf="$home/.config/hypr/hyprland.conf"
	if [[ -f "$conf" ]]; then
		rec="$(recorded_hash "$mf" "$conf" 2>/dev/null || true)"
		if [[ -n "$rec" && "$(sha "$conf")" == "$rec" ]]; then
			if (( dry )); then
				say "would remove obsolete ${conf/#$HOME/~}"
			else
				rm -f "$conf"
			fi
		fi
	fi

	apply_tree "$home" "$force" "$dry"
	# gtk/plasma defaults live outside the managed tree dirs
	install_gtk_user "$home" "$force" "$dry"
	install_plasma_user "$home" "$force" "$dry"
	apply_web_themes "$home" "$force" "$dry"
	# When --system runs as root, the state dir and manifest are created by
	# root. Hand them back to the account that owns the home directory, or
	# `webos-rice --doctor` cannot read its own manifest as that user.
	if [[ ${EUID} -eq 0 && ${dry} -eq 0 ]]; then
		local owner
		owner="$(stat -c '%u:%g' "$home")"
		chown -R "$owner" "$(state_dir "$home")" 2>/dev/null || true
		chown -R "$owner" "$home/.config" 2>/dev/null || true
	fi
	if (( dry )); then
		say "dry run complete for ${home} (no files written)"
	else
		done_ "rice applied to ${home}"
	fi
}

install_gtk_user() {
	local home="$1" force="$2" dry="$3" mf
	mf="$(manifest_of "$home")"
	install_file "${RICE_SRC}/gtk-3.0/settings.ini" "${home}/.config/gtk-3.0/settings.ini" "$mf" "$force" "$dry"
	install_file "${RICE_SRC}/gtk-4.0/settings.ini" "${home}/.config/gtk-4.0/settings.ini" "$mf" "$force" "$dry"
	install_file "${RICE_SRC}/fastfetch/fastfetch.json" "${home}/.config/fastfetch/fastfetch.json" "$mf" "$force" "$dry"
	[[ -f "${RICE_SRC}/fastfetch/webos.txt" ]] && install_file "${RICE_SRC}/fastfetch/webos.txt" "${home}/.config/fastfetch/webos.txt" "$mf" "$force" "$dry"
}

install_plasma_user() {
	local home="$1" force="$2" dry="$3" mf
	mf="$(manifest_of "$home")"
	[[ -d "${RICE_SRC}/plasma" ]] || return 0
	[[ -f "${RICE_SRC}/plasma/kdeglobals" ]] && install_file "${RICE_SRC}/plasma/kdeglobals" "${home}/.config/kdeglobals" "$mf" "$force" "$dry"
	[[ -f "${RICE_SRC}/plasma/kcminputrc" ]] && install_file "${RICE_SRC}/plasma/kcminputrc" "${home}/.config/kcminputrc" "$mf" "$force" "$dry"
	[[ -f "${RICE_SRC}/plasma/kwinrc" ]] && install_file "${RICE_SRC}/plasma/kwinrc" "${home}/.config/kwinrc" "$mf" "$force" "$dry"
	[[ -f "${RICE_SRC}/plasma/kwinrulesrc" ]] && install_file "${RICE_SRC}/plasma/kwinrulesrc" "${home}/.config/kwinrulesrc" "$mf" "$force" "$dry"
	[[ -f "${RICE_SRC}/konsolerc/konsolerc" ]] && install_file "${RICE_SRC}/konsolerc/konsolerc" "${home}/.config/konsolerc" "$mf" "$force" "$dry"
	(( dry )) || mkdir -p "${home}/.config/autostart" 2>/dev/null || true
}

# ── system-wide bits (run as root) ──────────────────────────────────────────
system_gtk() {
	local f
	for f in settings.ini gtk.css; do
		backup_once "/etc/gtk-3.0/$f"
		install -Dm0644 "${RICE_SRC}/gtk-3.0/$f" "/etc/gtk-3.0/$f"
		backup_once "/etc/gtk-4.0/$f"
		install -Dm0644 "${RICE_SRC}/gtk-4.0/$f" "/etc/gtk-4.0/$f"
	done
	done_ "system GTK theme written to /etc/gtk-3.0 and /etc/gtk-4.0"
}

system_greetd() {
	# SDDM is the display manager WebOS ships and configures. Only set up
	# greetd when it is actually the greeter and SDDM is not present; otherwise
	# both would try to own tty1 and the boot would be a race.
	if [[ -d /etc/sddm.conf.d ]] || command -v sddm >/dev/null 2>&1; then
		skip "SDDM is the display manager; leaving greetd alone"
		return 0
	fi
	[[ -d /etc/greetd ]] || { skip "greetd is not installed; skipping login setup"; return 0; }

	backup_once /etc/greetd/config.toml
	cat > /etc/greetd/config.toml <<'EOF'
# WebOS — greetd configuration. Written by `webos-rice --system`.
# A backup of the original is kept at config.toml.webos-orig.

[terminal]
# The VT greetd runs on.
vt = 1

[default_session]
# tuigreet: a black TUI greeter. No GTK, no WebKit, ~2 MB of RAM.
# The `--cmd` is what runs after a successful login.
command = "tuigreet \
    --cmd webos-session \
    --time --time-format '%H:%M' \
    --greeting '  WebOS  ' \
    --asterisks --remember --remember-session --user-menu \
    --width 46 --height 16 --window-padding 2 --container-padding 6 \
    --theme 'text=#e6e8eb;time=#7dd3fc;container=#000000;input=#e6e8eb;action=#9aa3ad;border=#ffffff14;title=#7dd3fc;greet=#9aa3ad;prompt=#7dd3fc;button=#e6e8eb'"

user = "greeter"
EOF

	backup_once /etc/greetd/environments.toml
	cat > /etc/greetd/environments.toml <<'EOF'
# WebOS sessions offered by the greeter.
hyprland
webos-session --gamescope
EOF

	# greetd must run as the `greeter` user; make sure it exists.
	if ! id greeter >/dev/null 2>&1; then
		useradd --system --create-home --home-dir /var/lib/greetd \
			--shell /sbin/nologin greeter 2>/dev/null || true
	fi

	# OpenRC: put greetd in the default runlevel, once.
	if [[ -x /sbin/rc-update ]] && [[ -f /etc/init.d/greetd ]]; then
		if ! rc-update show default 2>/dev/null | grep -qw greetd; then
			rc-update add greetd default >/dev/null 2>&1 || true
			note "greetd added to the default runlevel"
		fi
		# Do not fight greetd for the console.
		if [[ -f /etc/init.d/agetty.tty1 ]]; then
			rc-update del agetty.tty1 default >/dev/null 2>&1 || true
		fi
		# A Gentoo OpenRC stage3 keeps its console getty in /etc/inittab, so
		# comment out the tty1 line as well; greetd takes over the VT.
		if [[ -f /etc/inittab ]]; then
			backup_once /etc/inittab
			sed -i -E '/^[^#].*tty1/ s/^/#/' /etc/inittab
			note "disabled the tty1 getty in /etc/inittab (greetd owns tty1)"
		fi
	fi

	done_ "greetd configured (backups kept as *.webos-orig)"
}

system_wallpaper() {
	if [[ -x /usr/bin/webos-wallpaper ]]; then
		/usr/bin/webos-wallpaper --quiet || skip "wallpaper generation failed"
	fi
}

ensure_home() {
	# Install the rice only if this account has never had it, otherwise
	# just fill in files that are missing. Never overwrites user edits.
	local home="$1"
	[[ -d "$home" ]] || return 0
	if [[ -f "$(manifest_of "$home")" ]]; then
		apply_home "$home" 0 0
	else
		apply_home "$home" 1 0
	fi
}

ensure_all() {
	if [[ ${EUID} -eq 0 ]]; then
		ensure_home /etc/skel
		ensure_home /root
		local d
		for d in /home/*; do
			[[ -d "$d" ]] && ensure_home "$d"
		done
	else
		ensure_home "$HOME"
	fi
}

system_all() {
	local force="$1" u
	[[ ${EUID} -eq 0 ]] || die "--system must run as root"

	system_gtk
	system_greetd
	system_wallpaper

	# /etc/skel gets the rice so new accounts are themed on creation.
	mkdir -p /etc/skel
	apply_home /etc/skel "$force" 0
	apply_home /root "$force" 0

	# Existing accounts.
	local d
	for d in /home/*; do
		[[ -d "$d" ]] || continue
		u="$(basename "$d")"
		id "$u" >/dev/null 2>&1 || continue
		apply_home "$d" "$force" 0
		chown -R "${u}:${u}" "$d/.config" "$d/.local/state/webos" 2>/dev/null || true
	done

	done_ "system rice applied"
}

# ── doctor ──────────────────────────────────────────────────────────────────
# No pipelines with `grep -q` here: with pipefail the producer gets SIGPIPE
# and a healthy system reports a false failure.
zram_ok() {
	command -v swapon >/dev/null 2>&1 || return 0
	local swaps
	swaps="$(swapon --show=NAME --noheadings 2>/dev/null || true)"
	case "$swaps" in *zram*) return 0 ;; *) return 1 ;; esac
}

ananicy_ok() {
	command -v rc-update >/dev/null 2>&1 || return 0
	local list
	list="$(rc-update show default 2>/dev/null || true)"
	case "$list" in *ananicy-cpp*) return 0 ;; *) return 1 ;; esac
}

doctor() {
	local ok=0 bad=0
	chk() {
		if eval "$2" >/dev/null 2>&1; then
			printf '%s  ok%s   %s\n' "$C_G" "$C_R" "$1"; ok=$((ok+1))
		else
			printf '%s FAIL%s  %s  %s\n' "$C_E" "$C_R" "$1" "${3:-}"; bad=$((bad+1))
		fi
	}
	say "WebOS rice doctor"
	say ""
	chk "rice installed"           "[[ -d ${RICE_SRC} ]]"
	chk "Hyprland present"         "command -v Hyprland"
	# Hyprland 0.57+ only reads hyprland.lua. Check the real, active file and
	# make sure it is the WebOS config, not the upstream example.
	chk "hyprland.lua present"     "[[ -f \$HOME/.config/hypr/hyprland.lua ]]"
	chk "hyprland.lua is WebOS"    "grep -q 'webos-rice: Hyprland configuration' \$HOME/.config/hypr/hyprland.lua"
	chk "palette module present"   "[[ -f \$HOME/.config/hypr/webos-colors.lua ]]"
	chk "waybar present"           "command -v waybar"
	chk "waybar config present"    "[[ -f \$HOME/.config/waybar/config.jsonc && -f \$HOME/.config/waybar/style.css ]]"
	chk "wofi present"             "command -v wofi"
	chk "a terminal present"       "command -v kitty || command -v foot"
	chk "screenshot tools"         "command -v grim && command -v slurp"
	chk "zram swap active"         "zram_ok"      "run /etc/local.d/webos.start as root"
	chk "ananicy-cpp enabled"      "ananicy_ok"   "rc-update add ananicy-cpp.initd default"
	chk "wallpaper rendered"       "[[ -f ${WALL_DIR}/webos-wallpaper.png ]]"
	chk "Breeze_Light cursor"      "[[ -d /usr/share/icons/Breeze_Light/cursors ]]"
	chk "Qt6 platform theme plugin" "[[ -f /usr/lib64/qt6/plugins/platformthemes/libqt6ct.so ]]"
	chk "qt6ct colour scheme"      "[[ -f /usr/share/qt6ct/colors/darker.conf ]]"
	chk "hyprlock Pango colour"    "grep -Eq 'foreground=\"##[0-9A-Fa-f]{6}\"' \$HOME/.config/hypr/hyprlock.conf"
	chk "hyprlock options valid"   "! grep -Eq '^[[:space:]]*(grace|no_fade_in)[[:space:]]*=' \$HOME/.config/hypr/hyprlock.conf"
	chk "hypridle DPMS syntax"     "grep -q 'hl.dispatch(hl.dsp.dpms' \$HOME/.config/hypr/hypridle.conf"
	chk "fastfetch modules"          "[[ -f \$HOME/.config/fastfetch/fastfetch.json ]]"
	chk "rsvg-convert or magick"   "command -v rsvg-convert || command -v magick || command -v convert"
	# Do not use `grep -q` in these pipelines: with `set -o pipefail`, grep
	# exits as soon as it matches, fc-list gets SIGPIPE and the pipeline
	# returns 141 — a false failure for fonts that appear early in fc-list.
	chk "font: Inter"              "fc-list 2>/dev/null | grep -i 'Inter' >/dev/null || [[ -n \$(find /usr/share/fonts -iname 'Inter*' -print -quit 2>/dev/null) ]]"
	chk "font: JetBrains Mono NF"  "fc-list 2>/dev/null | grep -i 'JetBrainsMono' >/dev/null || [[ -n \$(find /usr/share/fonts -iname 'JetBrainsMono*' -print -quit 2>/dev/null) ]]"
	# SDDM is the default greeter; greetd is only a fallback. Failing this on a
	# healthy SDDM system was a false positive.
	chk "display manager"          "[[ -f /etc/greetd/config.toml ]] || [[ -f /etc/sddm.conf ]] || [[ -d /etc/sddm.conf.d ]] || command -v sddm || command -v greetd"
	chk "session entry"            "[[ -f /usr/share/wayland-sessions/webos.desktop ]]"
	# Only meaningful inside a running Wayland session.
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
		chk "waybar running"       "pgrep -x waybar"
		chk "hyprpaper running"    "pgrep -x hyprpaper"
		chk "polkit agent running" "pgrep -f 'lxqt-policykit-agent|hyprpolkitagent|polkit-gnome-authentication-agent'"
		chk "xdg portals running"  "pgrep -f '^/usr/libexec/xdg-desktop-portal$'"
	fi
	say ""
	say "${ok} ok, ${bad} failed"
	(( bad == 0 )) || return 1
}

toggle_panel() {
	if pgrep -x waybar >/dev/null 2>&1; then
		pkill -x waybar
		note "waybar hidden"
	else
		( waybar >/dev/null 2>&1 & )
		note "waybar shown"
	fi
}

list_trees() {
	local sub
	for sub in "${!TREES[@]}"; do
		printf '%-12s -> ~/%s\n' "$sub" "${TREES[$sub]}"
	done
}

# ── main ────────────────────────────────────────────────────────────────────
main() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--user)         MODE="user"; shift ;;
			--system)       MODE="system"; shift ;;
			--ensure)       MODE="ensure"; shift ;;
			--check|--dry-run) MODE="check"; shift ;;
			--force)        FORCE=1; shift ;;
			--quiet|-q)     QUIET=1; shift ;;
			--doctor)       doctor; exit $? ;;
			--toggle-panel) toggle_panel; exit 0 ;;
			--list)         list_trees; exit 0 ;;
			--wallpaper)    shift; MODE="wallpaper"; WALLPAPER="${1:-}"; shift ;;
			--wallpaper-menu) shift; MODE="wallpaper-menu"; WALLPAPER_DIR="${1:-/usr/share/webos/wallpaper}"; shift ;;
			--version)      printf 'webos-rice %s\n' "$VERSION"; exit 0 ;;
			-h|--help)      usage; exit 0 ;;
			*)              die "unknown option: $1" ;;
		esac
	done

	[[ -d "$RICE_SRC" ]] || die "rice not installed (${RICE_SRC} missing) — emerge webos-theme/webos-theme"

	case "$MODE" in
		wallpaper)
			set_wallpaper "$WALLPAPER"
			;;
		wallpaper-menu)
			wallpaper_menu "$WALLPAPER_DIR"
			;;
		user)
			apply_home "$HOME" "$FORCE" 0
			note "restart the compositor or run: hyprctl reload"
			;;
		system) system_all "$FORCE" ;;
		ensure) ensure_all ;;
		check)
			FORCE=0
			DRY_RUN=1
			say "dry run: no files will be written"
			apply_home "$HOME" 0 1
			;;
	esac
}

set_wallpaper() {
	local img="${1:-}" conf tmp
	[[ -n "$img" ]] || die "usage: webos-rice --wallpaper <image>"
	[[ -f "$img" ]] || die "no such image: $img"
	img="$(readlink -f "$img")"

	# Persist the choice so hyprpaper shows it again after a restart.
	conf="$HOME/.config/hypr/hyprpaper.conf"
	if [[ -f "$conf" ]]; then
		tmp="$(mktemp)"
		if awk -v img="$img" '
			BEGIN { done = 0 }
			/^[[:space:]]*wallpaper[[:space:]]*=/ && !done { print "wallpaper = ," img; done = 1; next }
			{ print }
			END { if (!done) print "wallpaper = ," img }
		' "$conf" > "$tmp"; then
			mv -f "$tmp" "$conf"
		else
			rm -f "$tmp"
		fi
	fi

	if ! pgrep -x hyprpaper >/dev/null 2>&1 && command -v hyprpaper >/dev/null 2>&1; then
		( hyprpaper >/dev/null 2>&1 & )
		sleep 1
	fi

	if pgrep -x hyprpaper >/dev/null 2>&1; then
		# hyprpaper's IPC: preload, then assign to every monitor ("" = all).
		hyprctl hyprpaper preload "$img" >/dev/null 2>&1 || true
		hyprctl hyprpaper wallpaper ",$img" >/dev/null 2>&1 \
			|| skip "hyprpaper did not accept the wallpaper"
	elif command -v swaybg >/dev/null 2>&1; then
		pkill -x swaybg 2>/dev/null || true
		( swaybg -i "$img" -m fill >/dev/null 2>&1 & )
	else
		skip "no wallpaper daemon (hyprpaper or swaybg) installed"
	fi
	note "wallpaper -> ${img}"
}

wallpaper_menu() {
	local dir="${WALLPAPER_DIR:-/usr/share/webos/wallpaper}"
	local list img
	[[ -d "$dir" ]] || die "no wallpaper directory: $dir"
	list="$(find "$dir" -maxdepth 1 -type f \
		\( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.bmp' \) \
		-print | sort)"
	[[ -n "$list" ]] || { skip "no wallpapers in ${dir}"; return 0; }
	if command -v fzf >/dev/null 2>&1; then
		img="$(printf '%s\n' "$list" | fzf --prompt 'wallpaper> ' --height 40%)" || return 0
	elif command -v wofi >/dev/null 2>&1; then
		img="$(printf '%s\n' "$list" | wofi --dmenu --prompt wallpaper)" || return 0
	else
		die "need fzf or wofi for the wallpaper menu"
	fi
	[[ -n "$img" ]] || return 0
	set_wallpaper "$img"
}

main "$@"
