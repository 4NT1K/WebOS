#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  webos-session — start a WebOS Wayland session.
#
#    webos-session              Hyprland + the WebOS rice (default)
#    webos-session --gamescope  a SteamOS-style gamescope session
#    webos-session --safe       Hyprland with the rice disabled (debugging)
#
#  This is what SDDM runs after login, and what the .desktop session entries
#  point at. It exists so that the environment is identical whether you start
#  from the greeter, a TTY, or a display manager.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

MODE="hyprland"
for arg in "$@"; do
	case "$arg" in
		--gamescope) MODE="gamescope" ;;
		--safe)      MODE="hyprland-safe" ;;
		--help|-h)   sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	esac
done

# ── environment ─────────────────────────────────────────────────────────────
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_CLASS=user
export XDG_SESSION_DESKTOP="Hyprland"
export XDG_CURRENT_DESKTOP="Hyprland"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
	mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
	chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
fi

# A session bus, if the login path did not provide one.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
	if command -v dbus-launch >/dev/null 2>&1; then
		eval "$(dbus-launch --sh-syntax)"
	fi
fi

# Tell the display manager / elogind who we are.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	dbus-update-activation-environment --systemd \
		WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
		XDG_RUNTIME_DIR DISPLAY WEBOS_SHELL 2>/dev/null || true
fi

# GPU hints. Only force a driver when the hardware is unambiguous: setting
# radeonsi on an Intel or NVIDIA box makes VA-API fail.
if [[ -z ${LIBVA_DRIVER_NAME:-} ]]; then
	if [[ -d /sys/module/nvidia || -e /dev/nvidia0 ]]; then
		export LIBVA_DRIVER_NAME=nvidia
		export GBM_BACKEND=nvidia-drm
		export __GLX_VENDOR_LIBRARY_NAME=nvidia
	elif [[ -d /sys/module/amdgpu ]]; then
		export LIBVA_DRIVER_NAME=radeonsi
		export VDPAU_DRIVER=radeonsi
	fi
	# Intel and everything else: leave Mesa's auto-detection alone.
fi

# ── rice ────────────────────────────────────────────────────────────────────
# Guarantee the WebOS theme exists for this account even if the installer
# skipped it (e.g. a Plasma-profile install that later logs into Hyprland).
if command -v webos-rice >/dev/null 2>&1; then
	webos-rice --ensure >/dev/null 2>&1 || true
fi

# ── run ─────────────────────────────────────────────────────────────────────
case "$MODE" in
	hyprland)
		command -v Hyprland >/dev/null 2>&1 || {
			printf 'webos-session: Hyprland is not installed\n' >&2
			printf '  emerge webos-desktop/webos-desktop\n' >&2
			exit 1
		}
		# Hyprland 0.57+ reads ~/.config/hypr/hyprland.lua (and ignores
		# hyprland.conf entirely). `webos-rice --ensure` above installs ours;
		# if that failed, let Hyprland use its own defaults instead of dying
		# on a missing file.
		cfg="$HOME/.config/hypr/hyprland.lua"
		[[ -f "$cfg" ]] || cfg=""
		# A home directory first themed by an older release may have a config
		# without the start-up lines for the bar, portals and wallpaper.
		# webos-autostart is locked and idempotent, so running it here as well
		# is harmless.
		if command -v webos-autostart >/dev/null 2>&1; then
			(
				ready=0
				for _ in $(seq 1 60); do
					if hyprctl version >/dev/null 2>&1; then
						ready=1
						break
					fi
					sleep 1
				done
				(( ready )) && exec webos-autostart hyprland
			) >/dev/null 2>&1 &
		fi
		if [[ -n "$cfg" ]]; then
			exec Hyprland -c "$cfg"
		fi
		exec Hyprland
		;;
	hyprland-safe)
		# Skip the rice: useful when a config change breaks the session.
		exec Hyprland -c /dev/null
		;;
	gamescope)
		exec /usr/bin/webos-gaming gamescope-session
		;;
	*)
		printf 'webos-session: unknown mode %s\n' "$MODE" >&2
		exit 1
		;;
esac
