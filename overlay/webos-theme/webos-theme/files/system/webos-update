#!/usr/bin/env bash
# webos-update — one-command WebOS system updater.
#
# The Portage equivalent of `pacman -Syu` / `cachy-update`:
# sync repos, rebuild @world with USE changes, clean orphans, fold in config
# file updates, update the WebOS kernel + GRUB config, update Flatpaks,
# re-apply the rice and tell you whether a reboot is needed.
#
# Usage:
#   webos-update                 update everything
#   webos-update --check         show what would be updated, change nothing
#   webos-update --yes           do not prompt for config-file merges
#   webos-update --no-sync       skip `emerge --sync`
#   webos-update --no-flatpak    skip `flatpak update`
#   webos-update --no-depclean   skip `emerge --depclean`
#   webos-update --no-kernel     skip the kernel/bootloader step
#   webos-update --quiet         only warnings and the summary
#   webos-update --strict-use    reject binpkgs whose USE/deps differ (compiles more)
#   webos-update --no-compile    never build from source; report missing binpkgs
#   webos-update --fast          alias for the default binpkg-first behaviour
#   webos-update --buildpkg      cache compiled packages for faster later updates
set -uo pipefail

VERSION="1.01"
LOG="/var/log/webos-update.log"
STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

CHECK=0
ASSUME_YES=0
DO_SYNC=1
DO_FLATPAK=1
DO_DEPCLEAN=1
DO_KERNEL=1
QUIET=0
PREFER_BINPKGS=1
NO_COMPILE=0
BUILD_PKG=0
FAILED=0

# ---------------------------------------------------------------- helpers ---
say()  { [ "$QUIET" -eq 1 ] || printf '\n\033[97m==>\033[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
warn() { printf '\033[93m  ! \033[0m%s\n' "$*"; }
ok()   { printf '\033[92m  ok\033[0m %s\n' "$*"; }
die()  { printf '\033[91m  xx\033[0m %s\n' "$*"; exit 1; }

usage() {
	sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
}

# Record a failure but keep going: one broken package should not stop the rest.
step_fail() { FAILED=$((FAILED + 1)); warn "$*"; }

need_root() {
	[ "$(id -u)" -eq 0 ] || die "webos-update must run as root (try: sudo webos-update)"
}

# The WebOS overlay is installed as a plain local repo (auto-sync = no), so
# `emerge --sync` never refreshes it. New ebuilds — including kernel security
# revisions — are published in the GitHub repo. Fetch the overlay directory
# from main and swap it in before resolving updates. A failed/offline fetch
# keeps the existing local copy and only produces a warning.
OVERLAY_URL="https://github.com/4NT1K/WebOS/archive/refs/heads/main.tar.gz"
sync_webos_overlay() {
	local tmp ov
	tmp="$(mktemp -d)" || return 1
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time 120 "$OVERLAY_URL" -o "$tmp/src.tar.gz" || { rm -rf "$tmp"; return 1; }
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$tmp/src.tar.gz" "$OVERLAY_URL" || { rm -rf "$tmp"; return 1; }
	else
		rm -rf "$tmp"; return 1
	fi
	tar -xzf "$tmp/src.tar.gz" -C "$tmp" 2>/dev/null || { rm -rf "$tmp"; return 1; }
	ov="$(find "$tmp" -type d -name overlay -print -quit 2>/dev/null)"
	[ -n "$ov" ] && [ -f "$ov/profiles/categories" ] || { rm -rf "$tmp"; return 1; }

	mkdir -p /var/lib/webos
	rm -rf /var/lib/webos/overlay.bak /usr/local/portage/webos.new
	cp -a "$ov" /usr/local/portage/webos.new || { rm -rf "$tmp"; return 1; }
	if [ -d /usr/local/portage/webos ]; then
		mv -f /usr/local/portage/webos /var/lib/webos/overlay.bak
	fi
	if ! mv -f /usr/local/portage/webos.new /usr/local/portage/webos; then
		[ -d /var/lib/webos/overlay.bak ] && mv -f /var/lib/webos/overlay.bak /usr/local/portage/webos
		rm -rf "$tmp"; return 1
	fi
	rm -rf /var/lib/webos/overlay.bak "$tmp"
	return 0
}

# ------------------------------------------------------------------ args ----
while [ $# -gt 0 ]; do
	case "$1" in
		-c|--check)      CHECK=1 ;;
		-y|--yes)        ASSUME_YES=1 ;;
		-n|--no-sync)    DO_SYNC=0 ;;
		--no-flatpak)    DO_FLATPAK=0 ;;
		--no-depclean)   DO_DEPCLEAN=0 ;;
		--no-kernel)     DO_KERNEL=0 ;;
		-q|--quiet)      QUIET=1 ;;
		--fast|--fast-binpkg) PREFER_BINPKGS=1 ;;
		--strict-use|--respect-use) PREFER_BINPKGS=0 ;;
		--no-compile)    NO_COMPILE=1; PREFER_BINPKGS=1 ;;
		--buildpkg)      BUILD_PKG=1 ;;
		-h|--help)       usage ;;
		*)               die "unknown option: $1 (try --help)" ;;
	esac
	shift
done

# Build one shared argument list so --check previews exactly what --apply runs.
EMERGE_WORLD_ARGS=(--verbose --update --deep --newuse --backtrack=100 \
	--autounmask-backtrack=y)
if [ "$PREFER_BINPKGS" -eq 1 ]; then
	EMERGE_WORLD_ARGS+=(--binpkg-respect-use=n --binpkg-changed-deps=n)
fi
if [ "$BUILD_PKG" -eq 1 ]; then
	EMERGE_WORLD_ARGS+=(--buildpkg)
fi

need_root

if [ "$NO_COMPILE" -eq 1 ]; then
	warn "Binary-only mode: updates without a matching binpkg will be reported, never compiled."
elif [ "$PREFER_BINPKGS" -eq 1 ]; then
	warn "Using stock binpkgs whose USE flags or dependencies differ from WebOS; some local tuning may be skipped. Use --strict-use to opt out."
fi

if [ "$CHECK" -eq 1 ]; then
	LOG=/dev/null
else
	# Everything below is captured, and still shown on the terminal.
	exec > >(tee -a "$LOG") 2>&1
	chmod 0644 "$LOG" 2>/dev/null || true
fi

say "WebOS update ($STAMP) — webos-update $VERSION"
note "log: $LOG"

# --------------------------------------------------------------- 1. sync ----
if [ "$DO_SYNC" -eq 1 ] && [ "$CHECK" -eq 0 ]; then
	say "[1/8] Syncing repositories"
	if emerge --sync --quiet; then
		ok "Gentoo repository up to date"
	else
		step_fail "emerge --sync failed (network or a stale mirror); continuing with the local tree"
	fi
	# Refresh the WebOS overlay too: this is where new kernel revisions and
	# WebOS-only app ebuilds live. It is auto-sync=no, so emerge --sync alone
	# never sees them.
	if sync_webos_overlay; then
		ok "WebOS overlay up to date (new ebuilds visible)"
	else
		step_fail "could not refresh the WebOS overlay — using the local copy"
	fi
else
	say "[1/8] Sync skipped (WebOS overlay not refreshed)"
fi

# ---------------------------------------------------------- 2. world ----
if [ "$CHECK" -eq 1 ]; then
	say "[2/8] Pending updates (dry run)"
	emerge --pretend "${EMERGE_WORLD_ARGS[@]}" @world
	rc=$?
	[ "$rc" -eq 0 ] || step_fail "dependency calculation failed (rc=$rc)"
	if [ "$DO_KERNEL" -eq 1 ]; then
		say "Kernel (updated separately from @world)"
		emerge --pretend --update --newuse sys-kernel/webos-kernel 2>/dev/null | sed 's/^/      /' || true
	fi
	say "Summary"
	note "run 'sudo webos-update' to apply"
	[ "$FAILED" -eq 0 ] || exit 1
	exit 0
fi

if [ "$NO_COMPILE" -eq 1 ]; then
	# --getbinpkgonly would reinstall hundreds of otherwise-fine packages whose
	# USE differs from the binhost. Pre-flight the normal binary-first graph and
	# refuse to continue if any package still requires a source build.
	say "[2/8] Checking for source builds (--no-compile)"
	DRYRUN="$(mktemp)"
	emerge --pretend "${EMERGE_WORLD_ARGS[@]}" @world > "$DRYRUN" 2>&1 || true
	mapfile -t SOURCE_BUILDS < <(grep '^\[ebuild' "$DRYRUN" || true)
	rm -f "$DRYRUN"
	if [ "${#SOURCE_BUILDS[@]}" -gt 0 ]; then
		printf '%s\n' "${SOURCE_BUILDS[@]}" | sed 's/^/      /'
		die "source build(s) required in --no-compile mode; install matching binpkgs or rerun without --no-compile"
	fi
	ok "only binary packages are scheduled"
fi

if [ "$PREFER_BINPKGS" -eq 1 ]; then
	say "[2/8] Updating @world (fast mode: stock binpkgs may override local USE)"
else
	say "[2/8] Updating @world (prefers prebuilt binaries; falls back to source)"
fi
if emerge "${EMERGE_WORLD_ARGS[@]}" --autounmask-write=y @world; then
	ok "world updated"
else
	step_fail "emerge @world reported an error — see $LOG"
fi

# Some packages were rebuilt in place; repair their dependants.
if emerge --quiet @preserved-rebuild; then
	ok "preserved rebuilds complete"
else
	step_fail "@preserved-rebuild reported an error"
fi

# ------------------------------------------------- 3. config file updates ---
say "[3/8] Config file updates"
pending="$(find /etc -name '._cfg????_*' -print 2>/dev/null | head -n 50)"
if [ -z "$pending" ]; then
	ok "no pending config changes"
elif [ "$ASSUME_YES" -eq 1 ]; then
	dispatch-conf --automerge=y >/dev/null 2>&1 || true
	ok "config changes merged automatically (keep-new is default)"
else
	warn "config files need merging; run 'dispatch-conf' to review:"
	printf '%s\n' "$pending" | sed 's/^/      /'
fi

# ------------------------------------------------------------- 4. depclean --
if [ "$DO_DEPCLEAN" -eq 1 ]; then
	say "[4/8] Removing orphaned packages"
	if emerge --quiet --depclean; then
		ok "depclean complete"
	else
		step_fail "depclean reported an error"
	fi
else
	say "[4/8] Depclean skipped"
fi

# ------------------------------------------------------------- 5. flatpak ---
if [ "$DO_FLATPAK" -eq 1 ] && command -v flatpak >/dev/null 2>&1; then
	say "[5/8] Updating Flatpaks"
	if flatpak update -y --noninteractive >/dev/null 2>&1; then
		ok "flatpaks up to date"
	else
		step_fail "flatpak update reported an error"
	fi
else
	say "[5/8] Flatpak skipped"
fi

# ----------------------------------------------------------------- 6. rice --
say "[6/8] Re-applying the Deep Black rice"
if command -v webos-rice >/dev/null 2>&1; then
	if webos-rice --system >/dev/null 2>&1; then
		ok "rice intact"
	else
		step_fail "webos-rice --system reported an error"
	fi
else
	note "webos-rice not installed; skipped"
fi

# -------------------------------------------------------- 7. kernel/boot ----
if [ "$DO_KERNEL" -eq 1 ]; then
	say "[7/8] WebOS kernel and bootloader"
	# sys-kernel/webos-kernel is emerged explicitly by the image build, not
	# recorded in @world, so an @world update alone would never fetch a new
	# kernel. Do it here, then refresh GRUB if a newer image landed in /boot.
	if emerge --quiet --update --newuse sys-kernel/webos-kernel >/dev/null 2>&1; then
		ok "WebOS kernel package up to date"
	else
		step_fail "sys-kernel/webos-kernel update failed — see $LOG"
	fi

	running="$(uname -r)"
	newest="$(ls -1 /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -V | tail -n 1)"
	if [ -n "$newest" ] && [ "$newest" != "$running" ]; then
		note "installed kernel: ${newest}, running: ${running}"
		grubcfg=/boot/grub/grub.cfg
		grubcmd=""
		for c in grub-mkconfig grub2-mkconfig; do
			if command -v "$c" >/dev/null 2>&1; then grubcmd="$c"; break; fi
		done
		if [ -n "$grubcmd" ] && { [ ! -f "$grubcfg" ] || [ "$grubcfg" -ot "/boot/vmlinuz-${newest}" ]; }; then
			if "$grubcmd" -o "$grubcfg" >/dev/null 2>&1; then
				ok "GRUB menu regenerated for ${newest}"
			else
				step_fail "could not regenerate $grubcfg"
			fi
		else
			note "GRUB menu already includes ${newest}"
		fi
		warn "reboot to start ${newest}"
		REBOOT=1
	else
		ok "running the newest installed kernel (${running})"
	fi
else
	say "[7/8] Kernel step skipped"
fi

# -------------------------------------------------------------- 8. report ---
say "[8/8] Health check"

# Unread news (Gentoo items that need a human).
unread="$(eselect news list 2>/dev/null | grep -c '^  *[0-9]\{4\}-' || true)"
[ "${unread:-0}" -gt 0 ] && warn "$unread unread news item(s): run 'eselect news read'"

if [ -e /var/run/reboot-required ] || [ -e /run/reboot-required ]; then
	warn "system requested a reboot"
	REBOOT=1
fi
if [ -n "${REBOOT:-}" ]; then
	note "reboot with: loginctl reboot"
else
	ok "no reboot needed"
fi

say "Summary"
if [ "$FAILED" -eq 0 ]; then
	ok "update finished with no errors"
else
	warn "$FAILED step(s) reported errors — review $LOG"
fi
exit $([ "$FAILED" -eq 0 ] && echo 0 || echo 1)
