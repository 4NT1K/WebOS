#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  webos-autostart — start the session services for a WebOS Wayland session.
#
#    webos-autostart hyprland
#
#  The WebOS mono rice is the only shell: waybar + mako + hypridle + hyprpaper.
#  WEBOS_SHELL is still read for compatibility but only selects the same stack.
#
#  Log: /tmp/webos-autostart.log
# ─────────────────────────────────────────────────────────────────────────────
set -u

COMPOSITOR="${1:-hyprland}"
SHELL_KIND="${WEBOS_SHELL:-ashen}"
export WEBOS_COMPOSITOR="$COMPOSITOR"
log=/tmp/webos-autostart.log

running() { pgrep -x -- "$1" >/dev/null 2>&1; }
note() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >>"$log"; }

note "start (compositor=$COMPOSITOR shell=$SHELL_KIND)"

# webos-session also calls this as a fallback for rice copies that predate the
# Hyprland exec-once lines. Serialize so only one instance starts services.
# A directory lock is used instead of flock: the daemons started below would
# inherit an flock file descriptor and keep the lock held for their lifetime.
lock="${XDG_RUNTIME_DIR:-/tmp}/webos-autostart.lock.d"
if ! mkdir "$lock" 2>/dev/null; then
	other="$(cat "$lock/pid" 2>/dev/null || true)"
	if [[ -n "$other" ]] && kill -0 "$other" 2>/dev/null; then
		note "another webos-autostart ($other) is running; skipping"
		exit 0
	fi
	# A just-created lock may not have its pid yet; only break old ones.
	if [[ -z "$other" ]] && (( $(date +%s) - $(stat -c %Y "$lock" 2>/dev/null || echo 0) < 30 )); then
		note "another webos-autostart is starting; skipping"
		exit 0
	fi
	rm -rf "$lock" 2>/dev/null || true
	mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock/pid" 2>/dev/null || true
trap 'rm -rf "$lock" 2>/dev/null || true' EXIT

# ── portals + polkit ────────────────────────────────────────────────────────
# webos-portals starts the portal implementations and the polkit agent.
if command -v webos-portals >/dev/null 2>&1; then
	note "starting webos-portals (shell=$SHELL_KIND)"
	webos-portals >>"$log" 2>&1 || note "webos-portals failed"
fi

# ── shell ───────────────────────────────────────────────────────────────────
if running waybar; then
	note "waybar already running"
elif command -v waybar >/dev/null 2>&1; then
	note "starting waybar"
	cfg="$HOME/.config/waybar/config.jsonc"
	[[ -f "$cfg" ]] || cfg=/usr/share/webos/rice/waybar/config.jsonc
	[[ -f "$cfg" ]] || cfg=/etc/xdg/waybar/config.jsonc
	st="$HOME/.config/waybar/style.css"
	[[ -f "$st" ]] || st=/usr/share/webos/rice/waybar/style.css
	[[ -f "$st" ]] || st=/etc/xdg/waybar/style.css
	for _ in 1 2 3 4 5; do
		waybar -c "$cfg" -s "$st" >>"$log" 2>&1 &
		sleep 2
		running waybar && break
		sleep 1
	done
	running waybar || note "waybar did not stay running (see $log)"
fi
if running mako; then
	note "mako already running"
elif command -v mako >/dev/null 2>&1; then
	note "starting mako"
	mako >>"$log" 2>&1 &
fi
if running hypridle; then
	note "hypridle already running"
elif command -v hypridle >/dev/null 2>&1 && [[ "$COMPOSITOR" == "hyprland" ]]; then
	note "starting hypridle"
	hypridle >>"$log" 2>&1 &
fi
# Night light. hyprsunset reads ~/.config/hypr/hyprsunset.conf and stays
# neutral until the first profile time; start it so the evening warm-up
# actually happens.
if running hyprsunset; then
	note "hyprsunset already running"
elif command -v hyprsunset >/dev/null 2>&1 && [[ "$COMPOSITOR" == "hyprland" ]]; then
	note "starting hyprsunset"
	hyprsunset >>"$log" 2>&1 &
fi

# ── wallpaper ───────────────────────────────────────────────────────────────
WALL=/usr/share/webos/wallpaper/webos-wallpaper.png
if running hyprpaper; then
	note "hyprpaper already running"
elif command -v hyprpaper >/dev/null 2>&1; then
	note "starting hyprpaper"
	hyprpaper >>"$log" 2>&1 &
	if [[ -f "$WALL" ]]; then
		for _ in 1 2 3 4 5; do
			sleep 1
			hyprctl hyprpaper preload "$WALL" >/dev/null 2>&1 \
				&& hyprctl hyprpaper wallpaper ",$WALL" >/dev/null 2>&1 \
				&& break
		done
	fi
fi

exit 0
