#!/usr/bin/env bash
# Install the WebOS glass CSS for Discord and Discord Canary through Vencord.
#
# Vencord is already injected into both clients and has Quick CSS enabled, so
# there is no need to patch core.asar (that broke Discord startup). Vencord
# watches quickCss.css, so edits show up without even restarting the app.
set -Eeuo pipefail

home_dir="${HOME:-/home/brah}"
rice_src="${WEBOS_RICE_SRC:-/usr/share/webos/rice/discord}"
[[ -f "$rice_src/webos-discord.css" ]] || rice_src="/home/brah/WebOS/overlay/webos-theme/webos-theme/files/rice/discord"
css_src="$rice_src/webos-discord.css"
[[ -f "$css_src" ]] || { printf 'fail: Discord CSS source missing\n' >&2; exit 1; }

settings_dir="$home_dir/.config/Vencord/settings"
[[ -d "$settings_dir" ]] || {
	printf 'warn: Vencord not found; Discord glass not installed\n'
	exit 0
}

python3 - "$settings_dir/settings.json" <<'PY'
import json, sys
p = sys.argv[1]
with open(p) as f:
    s = json.load(f)
if s.get("useQuickCss") is not True:
    s["useQuickCss"] = True
    with open(p, "w") as f:
        json.dump(s, f, indent=4)
        f.write("\n")
PY

python3 - "$settings_dir/quickCss.css" "$css_src" <<'PY'
import sys
target, source = sys.argv[1:3]
begin = "/* webos-discord:begin */"
end = "/* webos-discord:end */"
block = begin + "\n" + open(source).read().rstrip() + "\n" + end
try:
    cur = open(target).read()
except FileNotFoundError:
    cur = ""
if begin in cur and end in cur:
    pre, rest = cur.split(begin, 1)
    _, post = rest.split(end, 1)
    new = pre + block + post
else:
    new = (cur.rstrip() + "\n\n" if cur.strip() else "") + block + "\n"
if new != cur:
    open(target, "w").write(new)
PY

printf 'done: WebOS Discord glass installed in Vencord Quick CSS\n'
