# SanusOS amd64 profile defaults.
# The parent is Gentoo's stock amd64/17.1 profile. Everything below is what
# makes SanusOS different.

SANUS_OS="1"
SANUS_VERSION="1.0"

# Init and session. OpenRC + elogind; systemd is masked by use.mask.
USE="elogind -systemd"

# SanusOS ships a Wayland-first desktop. X stays enabled for XWayland and for
# the handful of games/tools that still need it.
USE="${USE} wayland X"

# Gaming-relevant defaults that everything benefits from.
USE="${USE} vulkan opengl egl gbm vaapi vdpau pipewire pulseaudio alsa"

# Quality-of-life defaults.
USE="${USE} udisks policykit dbus udev bluetooth networkmanager threads"

# Reduce the things that bloat a gaming image.
USE="${USE} -gnome -kde -doc -test -debug -cups -samba -ldap -kerberos"

# Our overlay's license policy: free software plus the redistributable blobs
# (firmware, microcode, Steam runtime) that a gaming OS needs.
ACCEPT_LICENSE="@FREE @BINARY-REDISTRIBUTABLE"

# Do not let the tree silently pull in a dist-kernel; we build our own.
USE="${USE} -dist-kernel"

# SanusOS defaults to the testing keyword for the desktop/gaming layer only.
ACCEPT_KEYWORDS="amd64"

# Multilib is required for Steam.
ABI_X86="64 32"

# Bootloader and live-medium defaults.
GRUB_PLATFORMS="efi-64 pc"

# L10N/LINGUAS: install English by default; add more via make.conf.
L10N="en"
LINGUAS="en"
