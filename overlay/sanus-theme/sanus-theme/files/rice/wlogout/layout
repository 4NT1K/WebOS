{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Log out",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend || loginctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate || loginctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot || reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff || poweroff",
    "text" : "Shut down",
    "keybind" : "s"
}
