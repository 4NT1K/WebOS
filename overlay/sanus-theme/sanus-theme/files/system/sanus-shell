#!/bin/sh
# WebOS shell wrapper.
# kitty is configured with `shell /usr/bin/sanus-shell`, so every interactive
# terminal shows the WebOS fastfetch card before handing over to the user's
# real shell. Nested shells are left alone via SANUS_FASTFETCH_SHOWN.
if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -z "${SANUS_FASTFETCH_SHOWN:-}" ]; then
	export SANUS_FASTFETCH_SHOWN=1
	if command -v fastfetch >/dev/null 2>&1; then
		fastfetch 2>/dev/null || true
	fi
fi

shell="${SHELL:-/bin/bash}"
# Never recurse if SHELL itself points at this wrapper.
[ "$shell" = "/usr/bin/sanus-shell" ] && shell=/bin/bash
exec "$shell" "$@"
