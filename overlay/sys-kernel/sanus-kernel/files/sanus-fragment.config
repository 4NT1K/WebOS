# ===========================================================================
# WebOS kernel configuration fragment
# ===========================================================================
# Applied with:
#     make defconfig
#     scripts/kconfig/merge_config.sh -m .config sanus-fragment.config
#     make olddefconfig
#
# The base is the upstream defconfig, which is sane and broad.  This fragment
# only *changes* things.  Every line here is a deliberate choice with a reason;
# if a line has no reason, it does not belong in this file.
#
# Rule: prefer mainline.  Patches add features (BORE, fsync, ntsync, BBRv3),
# the fragment configures them.  Nothing here should cost frames.
# ===========================================================================

# --- Identity --------------------------------------------------------------
CONFIG_LOCALVERSION="-webos"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="sanus"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_MODVERSIONS=y
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y

# --- Preemption and scheduler ----------------------------------------------
# PREEMPT_DYNAMIC lets us default to full preemption and still allow per-boot
# overrides via `preempt=`.  This is the biggest single desktop-latency win.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_DYNAMIC_CALL=y
CONFIG_SCHED_CORE=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_CLASS_EXT=y
# BORE (added by the bore patch; harmless if the patch is absent)
CONFIG_SCHED_BORE=y
# HZ=1000: smoother input and audio; costs a little idle power. Worth it.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NR_CPUS=512

# --- CPU frequency and power ------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_AMD_PSTATE=y
CONFIG_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_AMD_PSTATE_UT=m
CONFIG_ACPI_CPPC_LIB=y
CONFIG_X86_AMD_FREQ_SENSITIVITY=m
# Sensors, for `sensors`/lact/corectrl to read temps without a driver dance.
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_DRIVETEMP=m

# --- Memory ----------------------------------------------------------------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_FRONTSWAP=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
# MGLRU: much better reclaim behaviour on a desktop with a game resident.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Multigenerational-LRU tuning knobs (added by the mglru-knobs patch).
CONFIG_LRU_GEN_STATS=n

# --- Filesystems -----------------------------------------------------------
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_BTRFS_FS_REF_VERIFY=y
CONFIG_BTRFS_DEBUG=n
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=m
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_FUSE_FS=m
CONFIG_VIRTIO_FS=m
CONFIG_NFS_FS=m
CONFIG_CIFS=m

# --- Block layer -----------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_ACPI=y
CONFIG_SCSI_UFSHCD=m
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m
CONFIG_DM_INTEGRITY=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_CACHE=m
CONFIG_MD=y
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m

# --- Graphics --------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_ACP=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
CONFIG_HSA_AMD=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_VKMS=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_HIDRAW=y

# --- Input: controllers and arcade sticks ----------------------------------
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_UINPUT=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_JOYSTICK_PSXPAD_SPI=m
CONFIG_HID_STEAM=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_ELECOM=m
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_UHID=m
CONFIG_I2C_HID_ACPI=m

# --- Audio -----------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB=y
CONFIG_SND_HDA_PREALLOC_SIZE=2048
CONFIG_SND_SEQ_DUMMY=m

# --- Networking ------------------------------------------------------------
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_HTB=m
CONFIG_NET_CLS_ACT=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
# BBRv3 (added by the bbr3 patch)
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_NET_SCH="cake"
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_WIREGUARD=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_MACVLAN=m

# --- Virtualisation (VM gaming, Wine sandboxes) ----------------------------
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VIRTIO=m
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_HYPERV=m

# --- Namespaces and sandboxing (Steam/Proton require these) ----------------
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HAVE_ARCH_SECCOMP_FILTER=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_IO_URING=y
CONFIG_AIO=y

# --- Boot / firmware -------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE=""
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_ACPI=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_ADVANCED_DEBUG=n
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PROCESSOR_IDLE=y

# --- Security --------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y

# --- Cgroup / container bits used by Steam's pressure-vessel --------------
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_PSI_DEFAULT_DISABLED=n

# --- Misc quality of life --------------------------------------------------
CONFIG_UNIX_DIAG=m
CONFIG_INET_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m
CONFIG_DEVMEM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_HID_LED=m
CONFIG_LEDS_CLASS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_V4L2_FWNODE=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_DVB_USB=m
CONFIG_USB_GADGET=m
CONFIG_TYPEC=m
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_SBS=m
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ACPI_WMI=m
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HIDP=m
CONFIG_BT_LE=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_MT7921E=m
CONFIG_IWLWIFI=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_E1000E=m
CONFIG_8139TOO=m
CONFIG_VIRTIO_PCI=y

# --- WebOS live medium ---------------------------------------------------
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# --- Compiler compatibility -------------------------------------------------
# Kernel 6.12 predates GCC 16.  GCC 16 promotes new diagnostics to errors
# (e.g. -Wunterminated-string-initialization on ACPI 4-byte signature arrays)
# and CONFIG_WERROR makes every warning fatal.  Keep the kernel buildable with
# the current toolchain; warnings are still visible in the build log.
# CONFIG_WERROR is not set
