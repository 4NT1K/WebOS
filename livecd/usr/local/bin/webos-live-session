#!/bin/bash
# WebOS live session — what you see once the live medium has booted.
#
# Started automatically on tty1 (see /etc/profile.d/99-webos-live.sh). It is a
# thin menu in front of the installer: there is nothing else to do on a live
# medium, but a shell is one keystroke away when the installer misbehaves.
set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TERM="${TERM:-linux}"

# Safety net: never take over a real system.
if [[ ! -f /etc/webos-live ]]; then
	exec /bin/bash -l
fi

cd /root 2>/dev/null || cd /

banner() {
	clear 2>/dev/null || true
	# Take the version from the medium itself instead of hard-coding it; this
	# banner used to keep saying "1.021" on every later ISO.
	local pretty="WebOS"
	# shellcheck source=/dev/null
	[[ -r /etc/os-release ]] && . /etc/os-release && pretty="${PRETTY_NAME:-$pretty}"
	cat <<EOF

⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤
⣿⡿⢯⡉⠱⢾⣇⣶⠋⣀⠾⢁⡰⠞⠁⢰⠋⠉⠀⣀⠾⠉⢀⡰⠞⠁
⣿⢧⡈⢱⣶⡎⠉⣿⠶⠿⢶⣸⡇⠀⢀⡼⠄⠀⣀⠿⠀⢰⡎⠁⠀⠀
⣿⠚⢳⡎⠉⢱⣶⠉⠀⠀⣴⠛⠓⢲⣾⡇⡄⠀⣿⠀⠀⢸⡇⠀⠀⠀
⣿⣀⣸⣇⡰⠎⠉⠶⣀⣶⠉⢀⡰⠎⠉⠉⠉⣶⣿⣀⣀⣸⡇⠀⠀⠀
⣿⠉⢉⣹⡇⠀⣀⠶⠿⠿⣀⢸⡇⠀⠀⢀⠶⠉⠉⠉⣹⠿⠷⠆⠀⠀
⣿⠒⠚⠙⢳⣶⡃⠀⠀⠀⣼⣾⡇⠀⠀⢸⠀⠀⠀⣤⠓⠀⠀⠀⠀⠀
⣿⢠⣤⣤⣤⣼⡅⠀⣤⠛⠀⠀⠘⢣⡄⢸⠀⠀⠀⣿⠀⠀⠀⠀⠀⠀
⣿⠓⠀⠀⠀⠘⢻⣿⠀⠀⠀⣰⠤⠤⠼⠿⣀⠀⠀⣿⠀⠀⠀⠀⠀⠀
⣿⡰⠶⠶⠶⠶⣏⣿⠀⣀⠶⠁⠀⠀⠀⠀⠉⠶⣀⣿⠀⠀⠀⠀⠀⠀
⣿⠉⠀⠀⠀⠀⠈⠿⣶⠉⠀⠀⠀⠀⢀⣠⣤⣀⣍⣿⣀⠀⠀⠀⠀⠀
⣿⠀⢀⣀⣀⣀⡀⠀⠿⣀⠀⢀⡸⠿⠟⠀⠀⠀⠀⠀⠸⠄⠀⠀⠀⠀
⣿⡰⠾⠉⠉⠉⠳⠶⣀⣿⣀⡎⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⣿⠉⠀⠀⠀⠀⠀⠀⠉⠉⣿⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠛⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀

   ${pretty} — live medium
   No data is touched until you confirm the summary in the installer.

   1) Install WebOS to a disk
   2) Open a root shell
   3) Show what the installer can see  (webos-installer --check)

EOF
}

if [[ ! -x /usr/bin/webos-installer ]]; then
	echo "webos-installer is missing from this medium; dropping to a shell."
	exec /bin/bash -l
fi

while true; do
	banner
	read -r -p "  choice [1] > " choice || choice=""
	case "${choice:-1}" in
		1) exec /usr/bin/webos-installer ;;
		2) exec /bin/bash -l ;;
		3)
			/usr/bin/webos-installer --check
			echo
			read -r -p "  press Enter to return to the menu" _
			;;
		*)
			echo "  please enter 1, 2 or 3"
			sleep 1
			;;
	esac
done
